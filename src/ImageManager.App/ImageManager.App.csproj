<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>64.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="64.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />

    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImageManager.Core\ImageManager.Core.csproj" />
    <ProjectReference Include="..\ImageManager.Infrastructure\ImageManager.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy ffmpeg binaries to output directory -->
    <None Include="..\..\libffmpeg\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libffmpeg\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <!--
    Workaround: .NET publish doesn't include native runtime DLLs from
    NuGet packages. Adds onnxruntime*.dll to the publish file list via
    ResolvedFileToPublish during ComputeFilesToPublish — works for both
    CLI and VS publish.  DLLs are placed in runtimes/win-x64/native/
    AND in the EXE root (to beat C:\Windows\System32\onnxruntime.dll).
  -->
  <Target Name="IncludeOnnxNativeDlls" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_OnnxDll Include="$(OutDir)runtimes\win-x64\native\onnxruntime.dll" />
      <_OnnxDll Include="$(OutDir)runtimes\win-x64\native\onnxruntime_providers_cuda.dll" />
      <_OnnxDll Include="$(OutDir)runtimes\win-x64\native\onnxruntime_providers_shared.dll" />
      <_OnnxDll Include="$(OutDir)runtimes\win-x64\native\onnxruntime_providers_tensorrt.dll" />
    </ItemGroup>
    <!-- runtimes/{rid}/native/ for .deps.json resolution -->
    <ResolvedFileToPublish Include="@(_OnnxDll)" Condition="Exists('%(Identity)')">
      <RelativePath>runtimes\win-x64\native\%(Filename)%(Extension)</RelativePath>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </ResolvedFileToPublish>
    <!-- EXE root — LoadLibrary searches EXE dir before System32 -->
    <ResolvedFileToPublish Include="@(_OnnxDll)" Condition="Exists('%(Identity)')">
      <RelativePath>%(Filename)%(Extension)</RelativePath>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </ResolvedFileToPublish>
    <Message Importance="high" Text="Included @(_OnnxDll->Count()) ONNX runtime DLL(s) for publish" />
  </Target>
  </Target>
</Project>