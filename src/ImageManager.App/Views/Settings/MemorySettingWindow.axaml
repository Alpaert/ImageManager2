<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ImageManager.App.ViewModels"
        x:Class="ImageManager.App.Views.Settings.MemorySettingWindow"
        x:DataType="vm:MemorySettingViewModel"
        Title="内存与缓存设置"
        Width="500" Height="760"
        CanResize="True">

    <Grid RowDefinitions="*,Auto" Margin="16">
        <StackPanel Grid.Row="0" Spacing="14">
            <Border Padding="14" BorderBrush="{DynamicResource CtrlBorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Text="磁盘缓存位置" FontWeight="SemiBold" FontSize="14"/>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox Text="{Binding CachePath}" Width="350"/>
                        <Button Content="浏览..." Width="70" FontSize="12"
                                Click="BtnBrowseCachePath_Click"/>
                    </StackPanel>

                    <TextBlock Text="{Binding DiskUsageHint}"
                               Foreground="{DynamicResource MutedFgBrush}" FontSize="12"
                               TextWrapping="Wrap"/>
                    <TextBlock Foreground="{DynamicResource MutedFgBrush}" FontSize="11">
                        <Run Text="不同缩放档位的缓存以 w(宽度) 子目录存放 .jpg 文件。"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Padding="14" BorderBrush="{DynamicResource CtrlBorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Text="AI 打标设置" FontWeight="SemiBold" FontSize="14"/>

                    <!-- 打标模式 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="打标模式:"
                                   Foreground="{DynamicResource SecondaryFgBrush}" FontSize="12"/>
                        <ComboBox SelectedIndex="{Binding TagMode}" Width="360">
                            <ComboBoxItem Content="单模型 (仅 PixAI 打标) — 特征+角色"/>
                            <ComboBoxItem Content="双模型流水线 (WD 分级 + PixAI 打标) — 含画师识别"/>
                        </ComboBox>
                        <TextBlock Text="{Binding TagModeHint}"
                                   Foreground="{DynamicResource MutedFgBrush}" FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- 双模型流水线设置 -->
                    <StackPanel Spacing="4" IsVisible="{Binding IsEnsembleMode}">
                        <TextBlock Text="双模型流水线设置" FontWeight="SemiBold" FontSize="12"/>

                        <StackPanel Spacing="2">
                            <TextBlock Foreground="{DynamicResource SecondaryFgBrush}" FontSize="12">
                                <Run Text="每图最多标签数: "/><Run Text="{Binding EnsembleMaxTags}"/>
                            </TextBlock>
                            <Slider Minimum="10" Maximum="150"
                                    Value="{Binding EnsembleMaxTags}"
                                    TickFrequency="5" IsSnapToTickEnabled="True" Width="400"/>
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock Foreground="{DynamicResource SecondaryFgBrush}" FontSize="12"
                                       Text="{Binding PixaiMinConfidence, StringFormat='PixAI 打标置信度: {0:0.00}'}"/>
                            <Slider Minimum="0.05" Maximum="0.9"
                                    Value="{Binding PixaiMinConfidence}"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" Width="400"/>
                            <TextBlock Text="特征和角色标签的最低置信度，低于此值的标签被过滤"
                                       Foreground="{DynamicResource MutedFgBrush}" FontSize="11"/>
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock Foreground="{DynamicResource SecondaryFgBrush}" FontSize="12"
                                       Text="{Binding ArtistMatchThreshold, StringFormat='画师匹配阈值: {0:0.00}'}"/>
                            <Slider Minimum="0.1" Maximum="0.9"
                                    Value="{Binding ArtistMatchThreshold}"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" Width="400"/>
                            <TextBlock Text="嵌入向量余弦相似度阈值，越低越容易匹配但可能误判"
                                       Foreground="{DynamicResource MutedFgBrush}" FontSize="11"/>
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <CheckBox Content="启用自定义角色识别"
                                      IsChecked="{Binding EnableCharacterRecognition}"
                                      FontSize="12"/>
                            <TextBlock Foreground="{DynamicResource SecondaryFgBrush}" FontSize="12"
                                       Text="{Binding CharacterMatchThreshold, StringFormat='角色匹配阈值: {0:0.00}'}"/>
                            <Slider Minimum="0.1" Maximum="0.9"
                                    Value="{Binding CharacterMatchThreshold}"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" Width="400"/>
                            <TextBlock Foreground="{DynamicResource SecondaryFgBrush}" FontSize="12"
                                       Text="{Binding CharacterMaxMatches, StringFormat='每张图最多写入角色数: {0}'}"/>
                            <Slider Minimum="1" Maximum="5"
                                    Value="{Binding CharacterMaxMatches}"
                                    TickFrequency="1" IsSnapToTickEnabled="True" Width="400"/>
                            <TextBlock Text="仅双模型模式生效；使用角色嵌入库和 PixAI embedding 做本地相似度匹配"
                                       Foreground="{DynamicResource MutedFgBrush}" FontSize="11"/>
                        </StackPanel>

                    </StackPanel>

                    <!-- 单模型设置 -->
                    <StackPanel Spacing="4" IsVisible="{Binding IsSingleModelMode}">
                        <TextBlock Text="单模型设置" FontWeight="SemiBold" FontSize="12"/>
                        <StackPanel Spacing="2">
                            <TextBlock Foreground="{DynamicResource SecondaryFgBrush}" FontSize="12"
                                       Text="{Binding SingleModelMinConfidence, StringFormat='PixAI 打标置信度: {0:0.00}'}"/>
                            <Slider Minimum="0.05" Maximum="0.9"
                                    Value="{Binding SingleModelMinConfidence}"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" Width="400"/>
                        </StackPanel>
                    </StackPanel>

                    <Separator/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="DeepSeek API Key (用于 AI 推荐):"
                                   Foreground="{DynamicResource SecondaryFgBrush}" FontSize="12"/>
                        <TextBox Text="{Binding DeepSeekApiKey}" Width="400"
                                 PasswordChar="*"/>
                        <TextBlock Text="仅用于 AI 标签推荐功能，打标翻译已改用预翻译 CSV"
                                   Foreground="{DynamicResource MutedFgBrush}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
            <Button Content="取消" Width="80"
                    Click="BtnCancel_Click"/>
            <Button Content="确定" Width="80"
                    Command="{Binding SaveCommand}"
                    Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
