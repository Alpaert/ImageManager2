<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ImageManager.App.ViewModels"
        xmlns:conv="using:ImageManager.App.Converters"
        x:Class="ImageManager.App.Views.Settings.AutoTagReviewWindow"
        x:DataType="vm:AutoTagReviewViewModel"
        Title="Tag 翻译审核"
        Width="800" Height="600">

    <Window.Resources>
        <conv:ByteArrayToBitmapConverter x:Key="BytesToBitmap"/>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto" PointerPressed="Root_PointerPressed">
        <!-- Top bar -->
        <Border Grid.Row="0" Padding="12,8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource CtrlBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryFgBrush}" FontSize="14"/>
                <Button Grid.Column="1" Content="保存草稿" Margin="8,0" Padding="10,4"
                        Command="{Binding SaveDraftCommand}"
                        IsVisible="{Binding !IsSingleImageMode}"/>
                <Button Grid.Column="1" Content="保存映射" Margin="8,0" Padding="10,4"
                        Command="{Binding SaveMappingsCommand}"
                        IsVisible="{Binding IsSingleImageMode}"/>
                <Button Grid.Column="1" Content="保存到图片" Margin="8,0" Padding="10,4"
                        Command="{Binding SaveToImageCommand}"
                        IsVisible="{Binding IsSingleImageMode}"/>
                <Button Grid.Column="2" Content="全部确认" Margin="0,0,8,0" Padding="10,4"
                        Command="{Binding ConfirmAllCommand}"/>
                <Button Grid.Column="3" Content="×" Width="32" Height="32"
                        Click="Close_Click" Background="Transparent"/>
            </Grid>
        </Border>

        <!-- List -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TagTranslationItem">
                        <Border Padding="10,6" Margin="4,2"
                                Background="{DynamicResource CtrlBgBrush}"
                                CornerRadius="4">
                            <Grid ColumnDefinitions="Auto,Auto,*,200,80,100">
                                <!-- Delete button -->
                                <Button Grid.Column="0" Content="×" Width="28" Height="28"
                                        Padding="0" FontSize="14" Background="Transparent"
                                        Foreground="#E06060"
                                        Click="Delete_Click" Tag="{Binding}"/>

                                <!-- English tag -->
                                <Button Grid.Column="1"
                                        Content="{Binding EnglishTag}"
                                        Padding="8,4" FontSize="13"
                                        Click="EnglishTag_Click" Tag="{Binding EnglishTag}"/>

                                <!-- Chinese translation -->
                                <Grid Grid.Column="3">
                                    <TextBlock Text="{Binding DisplayText}"
                                               VerticalAlignment="Center" FontSize="13"
                                               Foreground="{DynamicResource AppFgBrush}"
                                               IsVisible="{Binding !IsEditing}"
                                               DoubleTapped="ChineseText_DoubleTapped" Tag="{Binding}"/>
                                    <TextBox Text="{Binding UserEditedText}"
                                             VerticalAlignment="Center" FontSize="13"
                                             IsVisible="{Binding IsEditing}"
                                             LostFocus="EditBox_LostFocus" Tag="{Binding}"/>
                                </Grid>

                                <!-- Image count -->
                                <TextBlock Grid.Column="4"
                                           Text="{Binding ImageCount, StringFormat='{}{0} 张'}"
                                           VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource MutedFgBrush}"/>

                                <!-- Confirm button -->
                                <Grid Grid.Column="5">
                                    <TextBlock Text="已确认" VerticalAlignment="Center"
                                               Foreground="#4CAF50" FontSize="12"
                                               FontWeight="Bold"
                                               IsVisible="{Binding IsConfirmed}"/>
                                    <Button Content="确认" Padding="8,4"
                                            Click="Confirm_Click" Tag="{Binding}"
                                            IsVisible="{Binding !IsConfirmed}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Bottom info -->
        <Border Grid.Row="2" Padding="12,6"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource CtrlBorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="双击中文列可编辑翻译 | 点击英文标签查看对应图片"
                       Foreground="{DynamicResource MutedFgBrush}" FontSize="11"/>
        </Border>
    </Grid>
</Window>
