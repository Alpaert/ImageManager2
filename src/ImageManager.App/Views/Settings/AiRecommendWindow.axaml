<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ImageManager.App.ViewModels"
        x:Class="ImageManager.App.Views.Settings.AiRecommendWindow"
        x:DataType="vm:AiRecommendViewModel"
        Title="AI 推荐"
        Width="700" Height="600"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto" Margin="12" RowSpacing="10">
        <!-- Input area -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="描述想要的图片类型：" FontSize="13" FontWeight="SemiBold"/>
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding InputText}"
                         PlaceholderText="例如：一个女孩在樱花树下微笑，阳光明媚，半身构图"
                         MinHeight="80"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         IsEnabled="{Binding IsLoading, Converter={x:Static BoolConverters.Not}}"/>
                <Button Grid.Column="1"
                        Content="确认"
                        Width="60"
                        VerticalAlignment="Top"
                        Margin="8,0,0,0"
                        Command="{Binding SendCommand}"/>
            </Grid>
            <TextBlock Text="点击确认后将用户需求和本地标签库发送给 AI，AI 返回推荐搜索组合"
                       FontSize="11"
                       Foreground="{DynamicResource SecondaryFgBrush}"/>
        </StackPanel>

        <!-- Output area -->
        <Border Grid.Row="1"
                Background="{DynamicResource CtrlBgBrush}"
                CornerRadius="6" Padding="8">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                    <TextBlock Text="推荐结果" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="（可选中文字后 Ctrl+C 复制）"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryFgBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="正在加载..."
                               FontSize="11"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsLoading}"/>
                </StackPanel>
                <TextBox Grid.Row="1"
                         Text="{Binding OutputText}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         FontSize="12"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>
    </Grid>
</Window>
