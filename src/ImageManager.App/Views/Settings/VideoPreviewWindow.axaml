<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ImageManager.App.ViewModels"
        xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
        x:Class="ImageManager.App.Views.Settings.VideoPreviewWindow"
        x:DataType="vm:VideoPreviewViewModel"
        Title="{Binding Title}"
        Width="800" Height="600"
        Background="Black">

    <Grid RowDefinitions="*,Auto" x:Name="RootGrid">
        <vlc:VideoView Grid.Row="0" x:Name="VideoPlayer"/>

        <!-- Navigation arrows overlaid on video (non-overlapping=native issue, but these are small and at edges) -->
        <Border Grid.Row="0" x:Name="ArrowLeft" VerticalAlignment="Center" HorizontalAlignment="Left"
                Background="#33000000" CornerRadius="4" Margin="8,0"
                Cursor="Hand" IsVisible="{Binding HasPrev}"
                PointerPressed="ArrowLeft_Click">
            <TextBlock Text="&#x25C0;" FontSize="32"
                       Foreground="#CCFFFFFF" Margin="4,12"/>
        </Border>

        <Border Grid.Row="0" x:Name="ArrowRight" VerticalAlignment="Center" HorizontalAlignment="Right"
                Background="#33000000" CornerRadius="4" Margin="8,0"
                Cursor="Hand" IsVisible="{Binding HasNext}"
                PointerPressed="ArrowRight_Click">
            <TextBlock Text="&#x25B6;" FontSize="32"
                       Foreground="#CCFFFFFF" Margin="4,12"/>
        </Border>

        <!-- Control bar in its own row — never overlaps native video surface -->
        <Border Grid.Row="1" x:Name="ControlBar" Padding="8,6"
                Background="#CC1A1A1A" BorderBrush="#333333" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Grid.Column="0" x:Name="BtnPlayPause" Content="&#x25B6;"
                        Width="30" Height="24" FontSize="14" Padding="0"
                        Click="BtnPlayPause_Click"/>
                <Slider Grid.Column="1" Margin="8,0"
                        Minimum="0" Maximum="1"
                        Value="{Binding Position}"
                        x:Name="VideoSlider"/>
                <Button Grid.Column="2" x:Name="BtnSubtitle" Content="字"
                        Width="22" Height="22" FontSize="11" Padding="0"
                        Margin="8,0,0,0"
                        Click="BtnSubtitle_Click"/>
                <Button Grid.Column="3" x:Name="BtnFullScreen" Content="&#x26F6;"
                        Width="28" Height="24" FontSize="14" Padding="0"
                        Margin="8,0,0,0"
                        Click="BtnFullScreen_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
