<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ImageManager.App.ViewModels"
        xmlns:models="using:ImageManager.Core.Models"
        x:Class="ImageManager.App.Views.Settings.TagManageWindow"
        x:DataType="vm:TagManageViewModel"
        Title="标签管理"
        Width="550" Height="650">

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <!-- Top: search -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,8">
            <TextBox Text="{Binding FilterText}"/>
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{DynamicResource SecondaryFgBrush}" FontSize="12"/>
        </StackPanel>

        <!-- List (virtualized — only ~50 items materialized for 10k tags) -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Tags}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:TagCount">
                    <Border Padding="8,4" Margin="0,2"
                            Background="{DynamicResource CtrlBgBrush}" CornerRadius="4">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                       VerticalAlignment="Center" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat='{}{0} 张'}"
                                       VerticalAlignment="Center" FontSize="12" Margin="8,0"
                                       Foreground="{DynamicResource MutedFgBrush}"/>
                            <Button Grid.Column="2" Content="重命名" Padding="6,2" FontSize="12"
                                    Margin="4,0" Click="Rename_Click" Tag="{Binding}"/>
                            <Button Grid.Column="3" Content="×" Width="28" Height="28"
                                    Padding="0" FontSize="14" Background="Transparent"
                                    Foreground="#E06060"
                                    Click="Delete_Click" Tag="{Binding}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Bottom -->
        <TextBlock Grid.Row="2" FontSize="11" Margin="0,8,0,0"
                   Foreground="{DynamicResource MutedFgBrush}"
                   Text="删除标签会从所有图片中移除此标签"/>
    </Grid>
</Window>
