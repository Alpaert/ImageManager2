<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ImageManager.App.ViewModels"
        xmlns:conv="using:ImageManager.App.Converters"
        x:Class="ImageManager.App.Views.Settings.PreviewWindow"
        x:DataType="vm:PreviewViewModel"
        Title="{Binding Title}"
        Width="800" Height="600">

    <Window.Resources>
        <conv:ByteArrayToBitmapConverter x:Key="BytesToBitmap"/>
    </Window.Resources>

    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0">
            <ScrollViewer x:Name="Scroller"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          SizeChanged="Scroller_SizeChanged"
                          Loaded="Scroller_Loaded"
                          PointerPressed="Scroller_PointerPressed"
                          PointerReleased="Scroller_PointerReleased"
                          PointerMoved="Scroller_PointerMoved">
                <Grid x:Name="ContentGrid"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Image x:Name="ImgFull"
                           Stretch="Uniform"/>
                    <Image x:Name="ImgGif"
                           Source="{Binding GifCurrentFrame, Converter={StaticResource BytesToBitmap}}"
                           Stretch="Uniform"
                           IsVisible="{Binding IsGif}"/>

                    <!-- Loading overlay -->
                    <Border x:Name="LoadingOverlay"
                            IsVisible="{Binding IsLoading}"
                            Background="#44000000"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            CornerRadius="8"
                            Padding="16,12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressBar Width="120" Height="4" IsIndeterminate="True"
                                         Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{Binding LoadingText}"
                                       Foreground="{DynamicResource AppFgBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Left arrow -->
            <Border x:Name="ArrowLeft" VerticalAlignment="Center" HorizontalAlignment="Left"
                    Background="#33000000" CornerRadius="4" Margin="8,0"
                    Cursor="Hand" IsVisible="{Binding HasPrev}"
                    PointerPressed="ArrowLeft_Click">
                <TextBlock x:Name="IconLeft" Text="◀" FontSize="32"
                           Foreground="#CCFFFFFF" Margin="4,12"/>
            </Border>

            <!-- Right arrow -->
            <Border x:Name="ArrowRight" VerticalAlignment="Center" HorizontalAlignment="Right"
                    Background="#33000000" CornerRadius="4" Margin="8,0"
                    Cursor="Hand" IsVisible="{Binding HasNext}"
                    PointerPressed="ArrowRight_Click">
                <TextBlock x:Name="IconRight" Text="▶" FontSize="32"
                           Foreground="#CCFFFFFF" Margin="4,12"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Padding="8,4"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CtrlBorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding InfoText}"
                       Foreground="{DynamicResource SecondaryFgBrush}" FontSize="12"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>