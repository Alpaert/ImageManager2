<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ImageManager.App.ViewModels"
        xmlns:appmodels="using:ImageManager.App.Models"
        xmlns:models="using:ImageManager.Core.Models"
        xmlns:controls="using:ImageManager.App.Controls"
        xmlns:conv="using:ImageManager.App.Converters"
        xmlns:avconv="using:Avalonia.Data.Converters"
        x:Class="ImageManager.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="图片管理工具"
        Width="1200" Height="700"
        Classes="workspace-window"
        Closing="Window_Closing">

	<Window.Resources>
		<conv:ByteArrayToBitmapConverter x:Key="BytesToBitmap"/>
		<conv:FolderByteArrayToBitmapConverter x:Key="FolderBytesToBitmap"/>
		<conv:HexToBrushConverter x:Key="HexToBrush"/>
		<DataTemplate x:Key="ThumbnailItemTemplate" x:DataType="vm:ImageViewItem">
			<!-- 此处margin数值是缩略框之间间距 -->
			<Border Margin="5" Padding="0"
					BorderThickness="{Binding $parent[Window].DataContext.ThumbnailBorderThickness}"
					CornerRadius="{Binding $parent[Window].DataContext.ThumbnailCornerRadius}"
					BorderBrush="{Binding $parent[Window].DataContext.ThumbnailBorderColor, Converter={StaticResource HexToBrush}}"
					Background="{Binding $parent[Window].DataContext.ThumbnailBackgroundColor, Converter={StaticResource HexToBrush}}"
					Opacity="{Binding $parent[Window].DataContext.ThumbnailOpacity}"
					PointerPressed="Thumbnail_PointerPressed"
					PointerEntered="Thumbnail_PointerEntered"
					PointerExited="Thumbnail_PointerExited"
					PointerMoved="Thumbnail_PointerMoved"
					PointerReleased="Thumbnail_PointerReleased"
					DoubleTapped="Thumbnail_DoubleTapped">
				<Border.ContextMenu>
					<ContextMenu Opened="ThumbnailContextMenu_Opened">
						<MenuItem Header="编辑 Tag" Click="MenuEditTag_Click" IsVisible="{Binding ShowStandardContextMenuItems}"/>
						<MenuItem Header="自动打标" Click="MenuAutoTag_Click" IsVisible="{Binding ShowStandardContextMenuItems}"/>
						<MenuItem Header="清空选中图片的标签" Click="MenuClearSelectedTags_Click" IsVisible="{Binding ShowStandardContextMenuItems}"/>
						<MenuItem Header="复制图片到剪贴板" Click="MenuCopyImage_Click" IsVisible="{Binding ShowStandardContextMenuItems}"/>
						<MenuItem Header="查找相似图片" IsVisible="{Binding ShowStandardContextMenuItems}">
							<MenuItem Header="框选搜图…" Click="MenuRegionSearch_Click"/>
							<MenuItem Header="感知相似" Tag="0" Click="MenuFindSimilar_Click"/>
							<MenuItem Header="语义相似" Tag="1" Click="MenuFindSimilar_Click"/>
							<MenuItem Header="氛围相似" Tag="2" Click="MenuFindSimilar_Click"/>
							<MenuItem Header="颜色相似" Tag="3" Click="MenuFindSimilar_Click"/>
						</MenuItem>
						<Separator IsVisible="{Binding ShowStandardContextMenuItems}"/>
						<MenuItem Header="在线搜图" IsVisible="{Binding ShowStandardContextMenuItems}">
							<MenuItem Header="不要来回切换ip地址，容易被搜图网站ban"/>
							<MenuItem Header="搜图网站比较慢，打开网页可能时间较久"/>
							<MenuItem Header="Multi（大杂烩搜图）" Click="MenuSearchOnline_Click" Tag="iqdb"/>
							<MenuItem Header="SauceNAO（P站推特）" Click="MenuSearchOnline_Click" Tag="saucenao"/>
							<MenuItem Header="yande.re（第三方图库）" Click="MenuSearchOnline_Click" Tag="yandere"/>
							<MenuItem Header="百度搜图" Click="MenuSearchOnline_Click" Tag="baidu"/>
							<MenuItem Header="ascii2d（p站推特）" Click="MenuSearchOnline_Click" Tag="ascii2d"/>
							<MenuItem Header="Trace（动画搜图）" Click="MenuSearchOnline_Click" Tag="tracemoe"/>
							<MenuItem Header="Yande" Click="MenuSearchOnline_Click" Tag="yandex"/>
							<MenuItem Header="Google" Click="MenuSearchOnline_Click" Tag="google"/>
							<MenuItem Header="Soutubot（本子）" Click="MenuSearchOnline_Click" Tag="soutubot"/>
							<MenuItem Header="Danbooru IQDB" Click="MenuSearchOnline_Click" Tag="danbooru_iqdb"/>
						</MenuItem>
						<MenuItem Header="重新生成缩略图" Click="MenuRegenerateThumbnail_Click" IsVisible="{Binding ShowStandardContextMenuItems}"/>
						<MenuItem Header="重新读取封面并生成缩略图" Click="MenuRegenerateMusicCover_Click" IsVisible="{Binding IsMusic}"/>
						<MenuItem Header="在资源管理器中打开" Click="MenuOpenInExplorer_Click"/>
						<Separator IsVisible="{Binding ShowStandardContextMenuItems}"/>
						<MenuItem Header="删除文件" Click="MenuDeleteFile_Click"/>
						<Separator IsVisible="{Binding ShowStandardContextMenuItems}"/>
						<MenuItem Header="复制到其他文件夹..." Click="MenuCopyFileToFolder_Click"/>
						<MenuItem Header="移动到其他文件夹..." Click="MenuMoveFileToFolder_Click"/>
						<Separator IsVisible="{Binding ShowStandardContextMenuItems}"/>
						<MenuItem Header="刷新当前文件夹" Click="MenuRefreshFolder_Click" IsVisible="{Binding ShowStandardContextMenuItems}"/>
					</ContextMenu>
				</Border.ContextMenu>
				<Grid>
					<!-- Content layer -->
					<Border Margin="{Binding $parent[Window].DataContext.ThumbnailPadding}"
							CornerRadius="{Binding $parent[Window].DataContext.ThumbnailInnerCornerRadius}"
							ClipToBounds="True">
						<Grid MinHeight="80">
							<!-- Placeholder color background while loading -->
							<Border Background="{Binding PlaceholderColor, Converter={StaticResource HexToBrush}}"
									CornerRadius="2">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static avconv:BoolConverters.And}">
                                        <Binding Path="!HasThumbnail" ElementName="GalleryThumbnail"/>
                                        <Binding Path="!HasNoPreview"/>
                                    </MultiBinding>
                                </Border.IsVisible>
                            </Border>
							<!-- Main image — fills entire thumbnail box -->
							<controls:AsyncThumbnailImage x:Name="GalleryThumbnail" Width="{Binding $self.(controls:SmartWaterfallPanel.ItemWidth)}"
									Height="{Binding $parent[Window].DataContext.GridThumbnailHeight}"
									ThumbnailData="{Binding ThumbnailData}"
									Stretch="{Binding $parent[Window].DataContext.ThumbnailImageStretch}"/>
							<!-- Music files without embedded artwork retain the card layout and show a clear in-place placeholder. -->
							<Panel IsVisible="{Binding ShowMusicPlaceholder}"
									IsHitTestVisible="False">
								<Border Width="48" Height="48"
										Background="#80000000"
										CornerRadius="24"
										HorizontalAlignment="Center"
										VerticalAlignment="Center">
									<Path Fill="White"
											Width="26" Height="26"
											Data="M17 3v13.55A4 4 0 1 0 19 20V7l8-2v9.55A4 4 0 1 0 29 18V2z"
											Stretch="Uniform"
											HorizontalAlignment="Center"
											VerticalAlignment="Center"/>
								</Border>
							</Panel>
							<!-- Media-type badges keep artwork thumbnails distinguishable from images. -->
							<Border IsVisible="{Binding IsVideo}"
									Width="24" Height="24" Margin="6"
									Background="#A0000000" CornerRadius="12"
									HorizontalAlignment="Right" VerticalAlignment="Top"
									IsHitTestVisible="False"
									ToolTip.Tip="视频">
								<Path Fill="White" Width="14" Height="14"
										Data="M4 6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2zm12 4 6-3v10l-6-3z"
										Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<Border IsVisible="{Binding IsMusic}"
									Width="24" Height="24" Margin="6"
									Background="#A0000000" CornerRadius="12"
									HorizontalAlignment="Right" VerticalAlignment="Top"
									IsHitTestVisible="False"
									ToolTip.Tip="音乐">
								<Path Fill="White" Width="14" Height="14"
										Data="M10 4v10.55A4 4 0 1 0 12 18V8l8-2v8.55A4 4 0 1 0 22 18V3z"
										Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<!-- Text overlay floating at bottom — does NOT affect image dimensions -->
							<Border VerticalAlignment="Bottom"
									Background="#AA000000" Padding="4,2"
									IsVisible="{Binding $parent[Window].DataContext.ShowAnyThumbnailText}">
								<StackPanel>
									<TextBlock Text="{Binding FileName}"
											IsVisible="{Binding $parent[Window].DataContext.ShowFileName}"
											FontSize="11" TextTrimming="CharacterEllipsis"
											Foreground="White" HorizontalAlignment="Center"
											MaxWidth="{Binding $parent[Window].DataContext.ThumbnailBaseWidth}"/>
									<TextBlock Text="{Binding StatusText}"
											IsVisible="{Binding $parent[Window].DataContext.ShowTags}"
											FontSize="10" Foreground="#CCCCCC"
											HorizontalAlignment="Center"/>
									<TextBlock Text="{Binding OrientationText}"
											IsVisible="{Binding $parent[Window].DataContext.ShowOrientation}"
											FontSize="10" Foreground="#CCCCCC"
											HorizontalAlignment="Center"/>
								</StackPanel>
							</Border>
							<!-- Video play control stays prominent without competing with the type badge. -->
							<Panel IsVisible="{Binding IsVideo}"
									IsHitTestVisible="False">
								<Border Width="48" Height="48"
										Background="#80000000"
										CornerRadius="24"
										HorizontalAlignment="Center"
										VerticalAlignment="Center">
										<Path Fill="White"
												Width="24" Height="24"
												Data="M8 5v14l11-7z"
												Stretch="Uniform"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"/>
									</Border>
							</Panel>
						</Grid>
					</Border>
					<!-- Selection highlight overlay -->
					<Border BorderBrush="#FF3D7FFF" BorderThickness="4"
							CornerRadius="{Binding $parent[Window].DataContext.ThumbnailSelectionCornerRadius}"
							IsVisible="{Binding IsSelected}"
							IsHitTestVisible="False"/>
				</Grid>
			</Border>
		</DataTemplate>

		<!-- Folder cards use the shared FolderViewItem projection; the attached panel
		     width keeps each card responsive while preserving a square cell. -->
        <DataTemplate x:Key="FolderCardTemplate" x:DataType="appmodels:FolderViewItem">
			<Border Width="{Binding $self.(controls:ResponsiveFolderGridPanel.ItemWidth)}"
					Height="{Binding $self.(controls:ResponsiveFolderGridPanel.ItemWidth)}"
					MinWidth="150" MinHeight="150" Margin="5" Padding="0"
					Background="{DynamicResource SurfaceBrush}"
					BorderBrush="{DynamicResource CtrlBorderBrush}" BorderThickness="1"
					CornerRadius="6"
					PointerPressed="FolderCard_PointerPressed"
					DoubleTapped="FolderCard_DoubleTapped">
				<Border.ContextMenu>
					<ContextMenu Opened="FolderCardContextMenu_Opened">
						<!-- Folder-only actions intentionally omit image-only commands. -->
						<MenuItem Header="清空所选图片/文件夹的标签…" Click="FolderCardClearTags_Click"/>
						<MenuItem Header="重新生成缩略图" Click="FolderCardRegenerateThumbnail_Click"/>
						<MenuItem Header="在资源管理器中打开" Click="FolderCardOpenInExplorer_Click"/>
						<Separator/>
						<MenuItem Header="删除文件夹" Click="FolderCardDelete_Click"/>
						<Separator/>
						<MenuItem Header="复制到其他文件夹…" Click="FolderCardCopy_Click"/>
						<MenuItem Header="移动到其他文件夹…" Click="FolderCardMove_Click"/>
					</ContextMenu>
				</Border.ContextMenu>
				<Grid RowDefinitions="*,Auto,Auto" MinHeight="150">
					<Border Grid.Row="0" Margin="5" CornerRadius="4" ClipToBounds="True"
							Background="{DynamicResource InputBgBrush}">
						<Image Source="{ReflectionBinding ThumbnailData, Converter={StaticResource FolderBytesToBitmap}}"
							   Stretch="UniformToFill"/>
					</Border>
							<TextBlock Grid.Row="1" Text="{ReflectionBinding DisplayName}"
							   Margin="8,2,8,0" FontWeight="SemiBold"
							   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
						<TextBlock Grid.Row="2" Text="{ReflectionBinding MediaCountText}"
							   Margin="8,0,8,7" FontSize="11"
							   Foreground="{DynamicResource MutedFgBrush}"
							   HorizontalAlignment="Center"/>
					<!-- Match media cards: selection is an overlay so it never changes card layout. -->
					<Border Grid.RowSpan="3" BorderBrush="#FF3D7FFF" BorderThickness="4" CornerRadius="6"
							IsVisible="{ReflectionBinding IsSelected}" IsHitTestVisible="False"/>
				</Grid>
			</Border>
		</DataTemplate>
	</Window.Resources>
	<Window.Styles>
		<StyleInclude Source="avares://ImageManager.App/Views/MainWindowStyles.axaml"/>
		<Style Selector="TreeViewItem">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}"/>
		</Style>
		<Style Selector="MenuItem">
			<Setter Property="Foreground" Value="{DynamicResource AppFgBrush}" />
		</Style>
		<Style Selector="MenuItem MenuItem">
			<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
		</Style>
		<Style Selector="MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
			<Setter Property="TextBlock.Foreground" Value="{Binding $parent[MenuItem].Foreground}" />
		</Style>
		<Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
			<Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
		</Style>
		<Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
			<Setter Property="Background" Value="{Binding $parent[Button].Background}" />
		</Style>
		<Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
		</Style>
	</Window.Styles>
    <Grid x:Name="RootGrid" Focusable="True" ColumnDefinitions="210,*,0,0" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Left Sidebar -->
        <Border x:Name="WorkspaceSidebar" Grid.Column="0" Grid.RowSpan="4"
                BorderBrush="{DynamicResource WorkspaceLineBrush}" BorderThickness="0,0,1,0"
                Background="{DynamicResource WorkspaceSidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12,0,12,5">
                    <StackPanel Height="62" Orientation="Horizontal" Spacing="9" Margin="7,0,0,0">
                        <Border Width="26" Height="26" CornerRadius="6" Margin="0,0,0,4"
                                Background="{DynamicResource WorkspaceBrandBrush}" VerticalAlignment="Center">
                            <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="ImageManager2" FontSize="15" FontWeight="SemiBold"
                                   Margin="0,0,0,4" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Height="34" Padding="10,0" CornerRadius="5"
                            Background="{DynamicResource WorkspaceSelectionBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource WorkspaceAccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="文件夹浏览" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto" Margin="9,21,0,0" Height="28">
                        <TextBlock Text="图片文件夹" Classes="workspace-meta"/>
                        <ToggleButton x:Name="WorkspaceFolderManage" Grid.Column="1" Content="管理"
                                      Background="Transparent" BorderThickness="0" CornerRadius="5"
                                      Padding="7,2" FontSize="12" ToolTip.Tip="管理图片文件夹"/>
                    </Grid>
                    <StackPanel Spacing="4" IsVisible="{Binding #WorkspaceFolderManage.IsChecked}" Margin="3,3,3,6">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="添加文件夹" Classes="workspace-quiet"
                                    FontSize="12" Padding="6,4"
                                    Click="BtnAddFolder_Click"/>
                            <Button Content="移除选中" Classes="workspace-quiet"
                                    FontSize="12" Padding="6,4"
                                    Click="BtnRemoveFolder_Click"/>
                        </StackPanel>
                        <Panel>
                            <TextBox x:Name="TxtFolderSearch" PlaceholderText="搜索文件夹..."
                                     Text="{Binding FolderSearchText}"
                                     GotFocus="TxtFolderSearch_GotFocus"
                                     Classes="toolbar-compact"/>
                            <Popup IsOpen="{Binding IsFolderSearchPopupOpen}"
                                   Placement="Bottom">
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource CtrlBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="6"
                                        MaxWidth="280">
                                    <ScrollViewer MaxHeight="300">
                                        <ItemsControl ItemsSource="{Binding FolderSearchSuggestions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FolderTreeNode">
                                                    <Button Margin="1" Padding="6,3" FontSize="12"
                                                            Click="FolderSuggestion_Click"
                                                            HorizontalContentAlignment="Stretch"
                                                            HorizontalAlignment="Stretch">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Path}" FontSize="10"
                                                                       Foreground="{DynamicResource MutedFgBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Panel>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Padding="12,8,12,10" MinHeight="51" BorderBrush="{DynamicResource WorkspaceLineBrush}"
                        BorderThickness="0,1,0,0">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="◐" Width="24" Padding="0" MinHeight="28"
                                Classes="workspace-quiet" Click="WorkspaceTheme_Click"
                                ToolTip.Tip="切换深色或浅色主题" AutomationProperties.Name="切换主题"/>
                        <Menu Classes="workspace-sidebar-menu" Background="Transparent">
                            <MenuItem Header="设置">
                                <MenuItem Header="设置主界面大小" Click="MenuSetMainSize_Click"/>
                                <MenuItem Header="设置预览窗口大小" Click="MenuSetPreviewSize_Click"/>
                                <Separator/>
                                <MenuItem Header="外观设置" Click="MenuAppearanceSettings_Click"/>
                                <MenuItem Header="壁纸设置" Click="MenuWallpaperSettings_Click"/>
                                <MenuItem Header="缩略图选项" Click="MenuThumbnailSettings_Click"/>
                                <MenuItem Header="缓存与 AI 设置" Click="MenuMemorySettings_Click"/>
                                <MenuItem Header="搜索设置" Click="MenuSearchSettings_Click"/>
                                <MenuItem Header="相似搜索向量索引" Click="MenuVectorIndexSettings_Click"/>
                                <MenuItem Header="归档文件夹" Click="MenuArchivedFolders_Click"/>
                                <Separator/>
                                <MenuItem Header="快捷键设置" Click="MenuShortcutSettings_Click"/>
                            </MenuItem>
                            <MenuItem Header="AI">
                                <MenuItem Header="AI 推荐" Click="MenuAiRecommend_Click"/>
                                <Separator/>
                                <MenuItem Header="画师嵌入库构建" Click="MenuArtistDbBuilder_Click"/>
                                <MenuItem Header="角色嵌入库构建" Click="MenuCharacterDbBuilder_Click"/>
                            </MenuItem>
                            <MenuItem Header="工具">
                                <MenuItem Header="标签管理" Click="MenuTagManage_Click"/>
                                <MenuItem Header="检测重复图片" Click="MenuDetectDuplicates_Click"/>
                            </MenuItem>
                            <MenuItem Header="帮助" Click="MenuHelp_Click"/>
                        </Menu>
                    </DockPanel>
                </Border>

                <TreeView x:Name="LstFolders" Classes="workspace-tree" Margin="12,0,12,6"
                          ItemsSource="{Binding FolderTree}"
                          SelectedItem="{Binding SelectedFolderNode}"
                          SelectionChanged="LstFolders_SelectionChanged"
                          DragDrop.AllowDrop="True"
                          DragDrop.DragOver="LstFolders_DragOver"
                          DragDrop.Drop="LstFolders_Drop"
                          PointerPressed="LstFolders_PointerPressed"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.ContextMenu>
                        <ContextMenu Opened="FolderContextMenu_Opened">
                            <MenuItem x:Name="FolderAutoTagMenu" Header="自动打标…" Click="MenuComputeAutoTags_Click"/>
                            <MenuItem x:Name="FolderCharacterMenu" Header="匹配角色标签…" Click="MenuMatchCharacterEmbeddingsRecursive_Click"/>
                            <Separator/>
                            <MenuItem Header="计算图片指纹…" Click="MenuComputeHashes_Click"/>
                            <MenuItem x:Name="FolderVideoMenu" Header="生成视频原始帧…" Click="MenuComputeVideoOriginalFramesRecursive_Click"/>
                            <MenuItem x:Name="FolderStopVideoMenu" Header="停止视频原始帧生成" IsVisible="False" Click="MenuStopVideoOriginalFrames_Click"/>
							<MenuItem x:Name="FolderPrewarmThumbnailsMenu" Header="递归预生成媒体缩略图…" Click="MenuPrewarmMediaThumbnails_Click"/>
							<MenuItem x:Name="FolderStopPrewarmThumbnailsMenu" Header="停止媒体缩略图预生成" IsVisible="False" Click="MenuStopPrewarmMediaThumbnails_Click"/>
                            <Separator/>
                            <MenuItem Header="设置显示名称…" Click="MenuRenameFolder_Click"/>
                            <MenuItem Header="归档文件夹" Click="MenuArchiveFolder_Click"/>
                            <MenuItem x:Name="FolderClearTagsMenu" Header="清空标签…" Click="MenuClearFolderTags_Click"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}">
                            <Border Padding="4" CornerRadius="4" ToolTip.Tip="{Binding Path}"
                                    Background="{Binding HighlightColor, Converter={StaticResource HexToBrush}}">
                                <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </Border>

        <Border x:Name="WorkspaceSearchBar" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                Padding="27,11,27,12" MinHeight="58"
                BorderBrush="{DynamicResource WorkspaceLineBrush}" BorderThickness="0,0,0,1"
                Background="{DynamicResource WorkspaceCanvasBrush}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="9">
                <Grid>
                <Grid ColumnDefinitions="Auto,*"
                      RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="5" VerticalAlignment="Center">
                    <StackPanel x:Name="WorkspaceSearchModesA" Orientation="Horizontal" Spacing="2">
                        <Button Content="标签搜索" Width="64" Height="34" Classes="workspace-tab workspace-tab-active"
                                Click="WorkspaceTagTab_Click"/>
                        <Button Content="自然语言搜图" Width="88" Height="34" Classes="workspace-tab">
                            <Button.Flyout>
                                <Flyout Placement="Bottom" FlyoutPresenterClasses="toolbar-flyout">
                                    <StackPanel Width="290" Spacing="8">
                                        <TextBox Classes="toolbar-compact" PlaceholderText="中文自然语言搜图"
                                                 Text="{Binding NaturalLanguageQuery}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="语义搜图" Classes="workspace-primary"
                                                    Command="{Binding SearchNaturalLanguageCommand}"/>
                                            <Button Content="停止搜索" Classes="workspace-quiet" Click="BtnStopSearch_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="ImageSearchButtonA" Content="以图搜图" Width="64" Height="34" Classes="workspace-tab"
                                ToolTip.Tip="选择相似模式，或直接拖入图片"
                                DragDrop.AllowDrop="True" DragDrop.DragOver="DragSearchZone_DragOver"
                                DragDrop.Drop="DragSearchZone_Drop">
                            <Button.Flyout>
                                <Flyout Placement="Bottom" FlyoutPresenterClasses="toolbar-flyout">
                                    <StackPanel Width="290" Spacing="8">
                                        <ComboBox x:Name="ImageSimilarityModeSelector" Classes="toolbar-compact" ItemsSource="{Binding SimilaritySearchModes}"
                                                  IsEnabled="{Binding CanSelectWholeImageSearchMode}"
                                                  SelectedIndex="{Binding SelectedSimilarityMode}"/>
                                        <Border x:Name="DragSearchZoneA" Classes="toolbar-drop-zone" Cursor="Hand"
                                                DragDrop.AllowDrop="True" DragDrop.DragOver="DragSearchZone_DragOver"
                                                DragDrop.Drop="DragSearchZone_Drop">
                                            <TextBlock Text="{Binding ImageDropSearchHint}" TextAlignment="Center" FontSize="12"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="框选搜图…" Classes="workspace-quiet" Click="ExternalRegionSearch_Click"/>
                                            <CheckBox x:Name="ImageDropRegionCheckBox" Content="拖入时框选" FontSize="12"
                                                      IsChecked="{Binding UseRegionSearchOnImageDrop, Mode=TwoWay}"
                                                      Click="ImageDropRegionOption_Click"
                                                      ToolTip.Tip="勾选后拖入图片进入框选；取消勾选按上方所选模式搜索"/>
                                        </StackPanel>
                                        <Button Content="停止搜索" Classes="workspace-quiet" HorizontalAlignment="Left"
                                                Click="BtnStopSearch_Click"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                    <Grid x:Name="WorkspaceSearchBodyA" Grid.Column="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                        <StackPanel>
                            <Border BorderBrush="{Binding SearchBoxBorderColor}" BorderThickness="1" CornerRadius="5">
                                <TextBox x:Name="TxtTagSearchA" Classes="toolbar-compact workspace-query" Text="{Binding TagSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="输入 Tag，例如：自然 a 森林" AutomationProperties.Name="标签搜索" Height="32"
                                         BorderThickness="0"
                                         KeyDown="TxtTagSearch_KeyDown" GotFocus="TxtTagSearch_GotFocus">
                                    <TextBox.InnerLeftContent>
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Classes="workspace-meta" Margin="10,0,2,0"/>
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                            </Border>
                            <Popup x:Name="TagSearchSuggestionsPopupA"
                                   IsOpen="{Binding IsTagSearchPopupOpen}"
                                   Placement="Bottom"
                                   TakesFocusFromNativeControl="False">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CtrlBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="6" MaxWidth="300">
                                    <StackPanel>
                                        <TextBox Classes="toolbar-compact" PlaceholderText="输入以联想共现 Tag..." Text="{Binding CoTagFilterText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsVisible="{Binding IsSuggestionCoTagMode}" Margin="0,0,0,4"/>
                                        <ScrollViewer MaxHeight="400">
                                            <ItemsControl ItemsSource="{Binding TagSearchSuggestions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:TagCount">
                                                        <Button Classes="toolbar-compact" Margin="2" Padding="0" Click="TagSuggestion_Click" Tag="{Binding}">
                                                            <Border Padding="6,3" CornerRadius="3"><TextBlock Text="{Binding Name}"/></Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                        <Button Grid.Column="1" Content="搜索" Width="48" Height="34" Padding="0"
                                Classes="workspace-primary" Command="{Binding SearchByTagCommand}" ToolTip.Tip="按 Tag 搜索"/>
                        <ComboBox Grid.Column="2" Classes="toolbar-compact" Width="118" Height="34" Padding="6,4"
                                  SelectedIndex="{Binding SearchScope}" AutomationProperties.Name="搜索范围">
                            <ComboBoxItem>当前文件夹</ComboBoxItem>
                            <ComboBoxItem>当前及子文件夹</ComboBoxItem>
                        </ComboBox>
                        <Button Grid.Column="3" Content="标签联想" Width="60" Height="34" Padding="0"
                                Classes="workspace-quiet" Click="WorkspaceSuggestions_Click"/>
                    </Grid>
                </Grid>

                </Grid>
                <Button x:Name="PreviewToggle" Grid.Column="1" Classes="workspace-quiet"
                        Classes.workspace-preview-active="{Binding DetailsPane.IsOpen}" Height="34" VerticalAlignment="Bottom"
                        Click="PreviewToggle_Click" AutomationProperties.Name="预览栏">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"
                              Stroke="{Binding #PreviewToggle.Foreground}" StrokeThickness="1.4"
                              Data="M2,2 H18 V18 H2 Z M12,2 V18"/>
                        <TextBlock x:Name="PreviewToggleLabel" Text="预览" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Keep the path and display controls above the scrolling gallery. -->
        <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Padding="24,10"
                IsVisible="{Binding IsRegionSearchActive}" Background="{DynamicResource WorkspaceCanvasBrush}">
            <DockPanel>
                <Button x:Name="RegionPreviewToggle" DockPanel.Dock="Right" Content="预览" Classes="workspace-quiet"
                        Classes.workspace-preview-active="{Binding DetailsPane.IsOpen}" Click="PreviewToggle_Click"/>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="以图搜图" FontWeight="SemiBold" FontSize="18"/>
                    <TextBlock Text="框选图片，发现相似内容" Classes="workspace-meta"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border x:Name="RegionQueryStrip" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                IsVisible="{Binding IsRegionSearchActive}" Margin="24,0,24,10" Padding="14,10"
                Background="{DynamicResource WorkspaceSurfaceBrush}" BorderBrush="{DynamicResource WorkspaceLineBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="3">
                    <TextBlock Text="{Binding RegionSearchInputName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding RegionSearchConditionText}" Classes="workspace-meta" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding RegionSearchStatus}" Classes="workspace-meta" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding RegionSearchStatus}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <CheckBox Content="包含子文件夹" IsChecked="{Binding RegionSearchRecursive}"/>
                    <Button Content="停止" Classes="workspace-quiet" IsVisible="{Binding IsRegionSearchBusy}" Click="RegionStop_Click"/>
                    <Button Content="返回图库" Classes="workspace-quiet" Click="RegionExit_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border x:Name="WorkspaceHeader" Grid.Row="1" Grid.Column="1" Padding="27,12,27,8">
            <StackPanel>
                <controls:ResponsiveBreadcrumbBar x:Name="FolderBreadcrumbBar"
                                                   ItemsSource="{Binding FolderBreadcrumbs}"
                                                   IsVisible="{Binding HasBreadcrumbs}"
                                                   Margin="0,0,0,5"
                                                   NavigateRequested="FolderBreadcrumb_NavigateRequested"/>
                <Grid x:Name="WorkspaceHeadingRow" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" MinHeight="34">
                    <WrapPanel x:Name="WorkspaceViewActions" Grid.Column="1" ItemSpacing="4" LineSpacing="4" Margin="8,0,0,0"
                               VerticalAlignment="Center">
                        <controls:DisplayFilterBar x:Name="DisplayFiltersBarA"/>
                        <Menu Background="Transparent">
                            <MenuItem Header="排序与视图 ▾" ToolTip.Tip="{Binding SortMenuHeader}" FontSize="12" Padding="4,4" Width="74" Height="32">
                                <MenuItem Header="组织方式" IsEnabled="False"/>
                                <MenuItem Header="全部文件混排"
                                          ToggleType="Radio"
                                          GroupName="SortScope"
                                          IsChecked="{Binding IsAllFilesSortScope, Mode=OneWay}"
                                          Command="{Binding SetSortScopeCommand}"
                                          CommandParameter="AllFiles"
                                          IsEnabled="{Binding ShowAllSubfolders}"/>
                                <MenuItem Header="按文件夹分组"
                                          ToggleType="Radio"
                                          GroupName="SortScope"
                                          IsChecked="{Binding IsFolderGroupedSortScope, Mode=OneWay}"
                                          Command="{Binding SetSortScopeCommand}"
                                          CommandParameter="FolderGrouped"
                                          IsEnabled="{Binding ShowAllSubfolders}"/>
                                <Separator/>
                                <MenuItem Header="排序依据" IsEnabled="False"/>
                                <MenuItem Header="文件名"
                                          ToggleType="Radio"
                                          GroupName="SortField"
                                          IsChecked="{Binding IsSortByFileName, Mode=OneWay}"
                                          Command="{Binding SetSortFieldCommand}"
                                          CommandParameter="FileName"/>
                                <MenuItem Header="修改时间"
                                          ToggleType="Radio"
                                          GroupName="SortField"
                                          IsChecked="{Binding IsSortByModified, Mode=OneWay}"
                                          Command="{Binding SetSortFieldCommand}"
                                          CommandParameter="Modified"/>
                                <MenuItem Header="文件大小"
                                          ToggleType="Radio"
                                          GroupName="SortField"
                                          IsChecked="{Binding IsSortByFileSize, Mode=OneWay}"
                                          Command="{Binding SetSortFieldCommand}"
                                          CommandParameter="FileSize"/>
                                <MenuItem Header="分辨率"
                                          ToggleType="Radio"
                                          GroupName="SortField"
                                          IsChecked="{Binding IsSortByResolution, Mode=OneWay}"
                                          Command="{Binding SetSortFieldCommand}"
                                          CommandParameter="Resolution"/>
                                <Separator/>
                                <MenuItem Header="顺序" IsEnabled="False"/>
                                <MenuItem Header="升序"
                                          ToggleType="Radio"
                                          GroupName="SortDirection"
                                          IsChecked="{Binding IsSortAscending, Mode=OneWay}"
                                          Command="{Binding SetSortDirectionCommand}"
                                          CommandParameter="Ascending"/>
                                <MenuItem Header="降序"
                                          ToggleType="Radio"
                                          GroupName="SortDirection"
                                          IsChecked="{Binding IsSortDescending, Mode=OneWay}"
                                          Command="{Binding SetSortDirectionCommand}"
                                          CommandParameter="Descending"/>
                                <Separator/>
                                <MenuItem Header="缩略图与排版…" Click="MenuThumbnailSettings_Click"/>
                                <MenuItem Header="外观与显示方式…" Click="MenuAppearanceSettings_Click"/>
                                <Separator/>
                                <MenuItem Header="清除所有筛选" Command="{Binding ClearFilterCommand}"/>
                            </MenuItem>
                        </Menu>
                        <CheckBox Content="全展示" IsChecked="{Binding ShowAllSubfolders}"
                                  Width="69" Height="32" Padding="4,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                    </WrapPanel>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Left" Classes="workspace-title-link" MaxWidth="240"
                                IsVisible="{Binding HasWorkspaceFolderTitle}" Click="WorkspaceFolderTitle_Click"
                                ToolTip.Tip="{Binding CurrentFolder}">
                            <TextBlock Text="{Binding WorkspaceTitle}" Classes="workspace-heading"/>
                        </Button>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding WorkspaceTitle}" Classes="workspace-heading" MaxWidth="240"
                                   IsVisible="{Binding !HasWorkspaceFolderTitle}" ToolTip.Tip="{Binding WorkspaceTitle}"/>
                        <TextBlock Text="{Binding WorkspaceCountText}" Classes="workspace-meta" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Grid>
                <WrapPanel ItemSpacing="6" LineSpacing="4">
                    <Button Content="{Binding TypeFilterText}" Classes="toolbar-chip" IsVisible="{Binding HasTypeFilter}"
                            Command="{Binding RemoveTypeFilterCommand}" ToolTip.Tip="移除此类型筛选"/>
                    <Button Content="{Binding OrientationFilterText}" Classes="toolbar-chip" IsVisible="{Binding HasOrientationFilter}"
                            Command="{Binding RemoveOrientationFilterCommand}" ToolTip.Tip="移除此方向筛选"/>
                    <Button Content="{Binding ContentRatingFilterText}" Classes="toolbar-chip" IsVisible="{Binding HasContentRatingFilter}"
                            Command="{Binding RemoveContentRatingFilterCommand}" ToolTip.Tip="移除此年龄分级筛选"/>
                    <TextBlock Text="{Binding DisplayFilterCountText}" Classes="workspace-meta"
                               IsVisible="{Binding HasDisplayFilter}"/>
                    <TextBlock Text="没有符合当前筛选的文件" Classes="workspace-meta"
                               IsVisible="{Binding IsDisplayFilterEmpty}"/>
                    <Button Content="重置" Classes="workspace-quiet" Command="{Binding ResetDisplayFilterCommand}"
                            IsVisible="{Binding IsDisplayFilterEmpty}"/>
                    <Button Content="清除所有筛选" Classes="workspace-quiet" Command="{Binding ClearFilterCommand}"
                            IsVisible="{Binding HasDisplayFilter}"/>
                    <Button Content="返回搜索前" Classes="workspace-quiet" IsVisible="{Binding IsShowingSearchResult}"
                            Command="{Binding BackFromSearchCommand}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid x:Name="WorkspaceGallery" Grid.Row="2" Grid.Column="1" Margin="27,3,27,0"
              ColumnDefinitions="0,*" RowDefinitions="Auto,*">
        <controls:RegionSearchPane x:Name="RegionSearchEditor" Grid.Column="0" Grid.RowSpan="2"
                                   IsVisible="{Binding IsRegionSearchActive}" Margin="0,0,12,8"/>
        <DockPanel Grid.Column="1" Margin="8,0,8,8" IsVisible="{Binding IsRegionSearchActive}">
            <Button x:Name="RegionLimitButton" DockPanel.Dock="Right" Content="{Binding RegionSearchResultLimitLabel}" Classes="workspace-quiet">
                <Button.Flyout>
                    <Flyout Opened="RegionLimitFlyout_Opened">
                        <StackPanel Spacing="10" Width="230">
                            <TextBlock Text="最大搜索结果数" FontWeight="SemiBold"/>
                            <TextBlock Text="与搜索设置共用，范围 1–500。" TextWrapping="Wrap"/>
                            <NumericUpDown x:Name="RegionResultLimitInput" Minimum="1" Maximum="500" Increment="1" FormatString="0"/>
                            <Button Content="应用" HorizontalAlignment="Right" Click="RegionLimitApply_Click"/>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="搜索结果" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding RegionSearchResultCount, StringFormat='{}{0} 张'}" Classes="workspace-meta"/>
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="RegionEmptyState" Grid.Column="1" Grid.Row="1" IsVisible="False"
                   Text="选择或拖入图片后，搜索结果会显示在这里" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Classes="workspace-meta"/>
            <!-- A single content surface: folders and media scroll together. -->
        <ScrollViewer x:Name="ThumbnailScrollViewer" Grid.Column="1" Grid.Row="1">
            <Grid x:Name="ImagePanelHost" RowDefinitions="Auto,Auto,*"
                  Background="Transparent"
                  PointerPressed="ImagePanelHost_PointerPressed"
                  PointerMoved="ImagePanelHost_PointerMoved"
                  PointerReleased="ImagePanelHost_PointerReleased">
				<!-- Direct child folders share the current thumbnail zoom baseline. -->
				<StackPanel Grid.Row="0" Margin="3,0,3,4" IsVisible="{ReflectionBinding ShowFolderSection}">
					<TextBlock Text="文件夹" Margin="8,5,8,1" FontWeight="SemiBold"
							   Foreground="{DynamicResource SecondaryFgBrush}"/>
					<ItemsControl x:Name="ItemsFolders" ItemsSource="{ReflectionBinding FolderItems}"
								  ItemTemplate="{StaticResource FolderCardTemplate}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<controls:ResponsiveFolderGridPanel
										MinItemWidth="{Binding $parent[Window].DataContext.ThumbnailBaseWidth}"
										ItemSpacing="10" ItemAspectRatio="1"/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
						</ItemsControl>
				</StackPanel>

				<Border Grid.Row="1" Margin="8,4,8,1" IsVisible="{ReflectionBinding ShowFolderSection}">
					<TextBlock Text="媒体文件" FontWeight="SemiBold"
							   Foreground="{DynamicResource SecondaryFgBrush}"/>
				</Border>

                <controls:ThumbnailItemsControl x:Name="ItemsImages" Grid.Row="2" ItemsSource="{Binding Images}"
                              ItemTemplate="{StaticResource ThumbnailItemTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:VirtualizingWaterfallPanel IsPaged="True" ViewportBuffer="800"
                            Mode="{Binding $parent[Window].DataContext.WaterfallMode}"
                            ColumnWidth="{Binding $parent[Window].DataContext.ThumbnailBaseWidth}"
                            GridThumbnailHeight="{Binding $parent[Window].DataContext.GridThumbnailHeight}"
                            KeepPadding="{Binding $parent[Window].DataContext.KeepPadding}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </controls:ThumbnailItemsControl>

                <controls:ThumbnailItemsControl x:Name="ContinuousItemsImages" Grid.Row="2"
                              ItemsSource="{Binding ContinuousImageItemSource}"
                              ItemTemplate="{StaticResource ThumbnailItemTemplate}"
                              IsVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:VirtualizingWaterfallPanel
                                GeometryIndex="{Binding $parent[Window].DataContext.ContinuousDisplayGeometryIndex}"
                                ViewportBuffer="800"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </controls:ThumbnailItemsControl>

                <!-- Selection rectangle overlay -->
                <Rectangle x:Name="SelectionRectangle"
					   Grid.RowSpan="3"
                           Stroke="#FF3D7FFF" StrokeThickness="1"
                           Fill="#403D7FFF"
                           IsVisible="False"
                           IsHitTestVisible="False"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>
            </Grid>
        </ScrollViewer>
		</Grid>


        <Border x:Name="WorkspaceFooter" Grid.Row="3" Grid.Column="1" Padding="27,2" MinHeight="35"
                Background="{DynamicResource WorkspaceCanvasBrush}"
                BorderBrush="{DynamicResource WorkspaceLineBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                            Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="缩略图" Classes="workspace-meta"/>
                    <Slider x:Name="WorkspaceZoomSlider" Classes="workspace-zoom" Minimum="1" Maximum="10" Value="{Binding ZoomTick}"
                            Width="80" VerticalAlignment="Center" AutomationProperties.Name="缩略图缩放">
                        <Slider.Resources>
                            <GridLength x:Key="SliderPreContentMargin">8</GridLength>
                            <GridLength x:Key="SliderPostContentMargin">8</GridLength>
                        </Slider.Resources>
                    </Slider>
                </StackPanel>
                <WrapPanel ItemSpacing="12" LineSpacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                IsVisible="{Binding IsPagedDisplay}">
                        <Button Content="‹" Classes="workspace-quiet" ToolTip.Tip="上一页"
                                AutomationProperties.Name="上一页" Command="{Binding PrevPageCommand}"/>
                        <ComboBox Classes="toolbar-compact" Width="68" ItemsSource="{Binding PageNumbers}"
                                  VerticalAlignment="Center" PlaceholderText="跳页" AutomationProperties.Name="当前页码"
                                  SelectedIndex="{Binding CurrentPage}"/>
                        <TextBlock Text="/" Classes="workspace-meta"/>
                        <TextBlock Text="{Binding TotalPages}" Classes="workspace-meta"/>
                        <Button Content="›" Classes="workspace-quiet" ToolTip.Tip="下一页"
                                AutomationProperties.Name="下一页" Command="{Binding NextPageCommand}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                IsVisible="{Binding HasSearchResults}">
                        <Button Content="‹" Classes="workspace-quiet" ToolTip.Tip="上一项搜索结果"
                                AutomationProperties.Name="上一项搜索结果" Command="{Binding PrevResultCommand}"/>
                        <TextBlock Text="{Binding SearchResultInfo}" Classes="workspace-meta"
                                   Foreground="{DynamicResource WorkspaceAccentBrush}"/>
                        <Button Content="›" Classes="workspace-quiet" ToolTip.Tip="下一项搜索结果"
                                AutomationProperties.Name="下一项搜索结果" Command="{Binding NextResultCommand}"/>
                    </StackPanel>
                    <TextBlock x:Name="WorkspaceLoadedInfo" Text="{Binding LoadedInfoText}" Classes="workspace-meta">
                        <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsPagedDisplay"/>
                                <Binding Path="LoadedInfoText" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                            </MultiBinding>
                        </TextBlock.IsVisible>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusText}" Classes="workspace-meta" MaxWidth="290"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}"
                               IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="{Binding BackgroundStatusText}" Classes="workspace-meta" MaxWidth="290"
                               Foreground="{DynamicResource WorkspaceAccentBrush}" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding BackgroundStatusText}"
                               IsVisible="{Binding BackgroundStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <Button Content="停止推理" Classes="workspace-quiet" VerticalAlignment="Center"
                            IsVisible="{Binding IsAutoTagRunning}" Command="{Binding StopAutoTagCommand}"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Border x:Name="DetailSplitter" Grid.Row="1" Grid.RowSpan="3" Grid.Column="2"
                IsVisible="False" Background="Transparent" Cursor="SizeWestEast" Focusable="True"
                Classes="workspace-preview-splitter" ZIndex="2"
                PointerPressed="DetailSplitter_PointerPressed" PointerMoved="DetailSplitter_PointerMoved"
                PointerReleased="DetailSplitter_PointerReleased" PointerCaptureLost="DetailSplitter_PointerCaptureLost"
                KeyDown="DetailSplitter_KeyDown">
            <Grid IsHitTestVisible="False">
                <Border Width="1" Background="{DynamicResource WorkspaceLineBrush}" HorizontalAlignment="Center"/>
                <Border Classes="workspace-preview-grip" Width="3" Height="35" CornerRadius="2"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <controls:DetailPreviewPane x:Name="DetailsPaneView" Grid.Row="1" Grid.RowSpan="3" Grid.Column="3"
                                    DataContext="{Binding DetailsPane}" IsVisible="False" ZIndex="1"/>

        <Popup x:Name="HoverPreviewHost"
               ShouldUseOverlayLayer="True"
               Placement="AnchorAndGravity"
               PlacementAnchor="TopLeft"
               PlacementGravity="BottomRight"
               IsLightDismissEnabled="False"
               TakesFocusFromNativeControl="False"
               Topmost="True">
            <controls:HoverPreviewPopup x:Name="HoverPreviewContent" IsHitTestVisible="False"/>
        </Popup>

    </Grid>
</Window>
