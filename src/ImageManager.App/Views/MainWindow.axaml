<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ImageManager.App.ViewModels"
        xmlns:models="using:ImageManager.Core.Models"
        xmlns:controls="using:ImageManager.App.Controls"
        xmlns:conv="using:ImageManager.App.Converters"
        x:Class="ImageManager.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="图片管理工具"
        Width="1200" Height="700"
        Closing="Window_Closing">

	<Window.Resources>
		<conv:ByteArrayToBitmapConverter x:Key="BytesToBitmap"/>
		<conv:HexToBrushConverter x:Key="HexToBrush"/>
		<DataTemplate x:Key="ThumbnailItemTemplate" x:DataType="vm:ImageViewItem">
			<!-- 此处margin数值是缩略框之间间距 -->
			<Border Margin="5" Padding="0"
					BorderThickness="{Binding $parent[Window].DataContext.ThumbnailBorderThickness}"
					CornerRadius="{Binding $parent[Window].DataContext.ThumbnailCornerRadius}"
					BorderBrush="{Binding $parent[Window].DataContext.ThumbnailBorderColor, Converter={StaticResource HexToBrush}}"
					Background="{Binding $parent[Window].DataContext.ThumbnailBackgroundColor, Converter={StaticResource HexToBrush}}"
					Opacity="{Binding $parent[Window].DataContext.ThumbnailOpacity}"
					PointerPressed="Thumbnail_PointerPressed"
					PointerEntered="Thumbnail_PointerEntered"
					PointerExited="Thumbnail_PointerExited"
					PointerMoved="Thumbnail_PointerMoved"
					PointerReleased="Thumbnail_PointerReleased"
					DoubleTapped="Thumbnail_DoubleTapped">
				<Border.ContextMenu>
					<ContextMenu Opened="ThumbnailContextMenu_Opened">
						<MenuItem Header="编辑 Tag" Click="MenuEditTag_Click"/>
						<MenuItem Header="自动打标" Click="MenuAutoTag_Click"/>
						<MenuItem Header="清空选中图片的标签" Click="MenuClearSelectedTags_Click"/>
						<MenuItem Header="复制图片到剪贴板" Click="MenuCopyImage_Click"/>
						<MenuItem Header="查找相似图片">
							<MenuItem Header="感知相似" Tag="0" Click="MenuFindSimilar_Click"/>
							<MenuItem Header="语义相似" Tag="1" Click="MenuFindSimilar_Click"/>
							<MenuItem Header="氛围相似" Tag="2" Click="MenuFindSimilar_Click"/>
							<MenuItem Header="颜色相似" Tag="3" Click="MenuFindSimilar_Click"/>
						</MenuItem>
						<Separator/>
						<MenuItem Header="在线搜图">
							<MenuItem Header="不要来回切换ip地址，容易被搜图网站ban"/>
							<MenuItem Header="搜图网站比较慢，打开网页可能时间较久"/>
							<MenuItem Header="Multi（大杂烩搜图）" Click="MenuSearchOnline_Click" Tag="iqdb"/>
							<MenuItem Header="SauceNAO（P站推特）" Click="MenuSearchOnline_Click" Tag="saucenao"/>
							<MenuItem Header="yande.re（第三方图库）" Click="MenuSearchOnline_Click" Tag="yandere"/>
							<MenuItem Header="百度搜图" Click="MenuSearchOnline_Click" Tag="baidu"/>
							<MenuItem Header="ascii2d（p站推特）" Click="MenuSearchOnline_Click" Tag="ascii2d"/>
							<MenuItem Header="Trace（动画搜图）" Click="MenuSearchOnline_Click" Tag="tracemoe"/>
							<MenuItem Header="Yande" Click="MenuSearchOnline_Click" Tag="yandex"/>
							<MenuItem Header="Google" Click="MenuSearchOnline_Click" Tag="google"/>
							<MenuItem Header="Soutubot（本子）" Click="MenuSearchOnline_Click" Tag="soutubot"/>
							<MenuItem Header="Danbooru IQDB" Click="MenuSearchOnline_Click" Tag="danbooru_iqdb"/>
						</MenuItem>
						<MenuItem Header="重新生成缩略图" Click="MenuRegenerateThumbnail_Click"/>
						<MenuItem Header="在资源管理器中打开" Click="MenuOpenInExplorer_Click"/>
						<Separator/>
						<MenuItem Header="删除该图片文件" Click="MenuDeleteFile_Click"/>
						<Separator/>
						<MenuItem Header="复制到其他文件夹..." Click="MenuCopyFileToFolder_Click"/>
						<MenuItem Header="移动到其他文件夹..." Click="MenuMoveFileToFolder_Click"/>
						<Separator/>
						<MenuItem Header="刷新当前文件夹" Click="MenuRefreshFolder_Click"/>
					</ContextMenu>
				</Border.ContextMenu>
				<Grid>
					<!-- Content layer -->
					<Border Margin="{Binding $parent[Window].DataContext.ThumbnailPadding}"
							CornerRadius="{Binding $parent[Window].DataContext.ThumbnailInnerCornerRadius}"
							ClipToBounds="True">
						<Grid MinHeight="80">
							<!-- Placeholder color background while loading -->
							<Border Background="{Binding PlaceholderColor, Converter={StaticResource HexToBrush}}"
									IsVisible="{Binding IsNotLoaded}"
									CornerRadius="2"/>
							<!-- Main image — fills entire thumbnail box -->
							<Image Width="{Binding $self.(controls:SmartWaterfallPanel.ItemWidth)}"
									Height="{Binding $parent[Window].DataContext.GridThumbnailHeight}"
									Source="{Binding ThumbnailData, Converter={StaticResource BytesToBitmap}}"
									Stretch="{Binding $parent[Window].DataContext.ThumbnailImageStretch}"/>
							<!-- Text overlay floating at bottom — does NOT affect image dimensions -->
							<Border VerticalAlignment="Bottom"
									Background="#AA000000" Padding="4,2"
									IsVisible="{Binding $parent[Window].DataContext.ShowAnyThumbnailText}">
								<StackPanel>
									<TextBlock Text="{Binding FileName}"
											IsVisible="{Binding $parent[Window].DataContext.ShowFileName}"
											FontSize="11" TextTrimming="CharacterEllipsis"
											Foreground="White" HorizontalAlignment="Center"
											MaxWidth="{Binding $parent[Window].DataContext.ThumbnailBaseWidth}"/>
									<TextBlock Text="{Binding StatusText}"
											IsVisible="{Binding $parent[Window].DataContext.ShowTags}"
											FontSize="10" Foreground="#CCCCCC"
											HorizontalAlignment="Center"/>
									<TextBlock Text="{Binding OrientationText}"
											IsVisible="{Binding $parent[Window].DataContext.ShowOrientation}"
											FontSize="10" Foreground="#CCCCCC"
											HorizontalAlignment="Center"/>
								</StackPanel>
							</Border>
							<!-- Video play icon overlay -->
							<Panel IsVisible="{Binding IsVideo}"
									IsHitTestVisible="False">
								<Border Width="48" Height="48"
										Background="#80000000"
										CornerRadius="24"
										HorizontalAlignment="Right"
										VerticalAlignment="Bottom"
										Margin="0,0,8,8">
										<Path Fill="White"
												Width="24" Height="24"
												Data="M8 5v14l11-7z"
												Stretch="Uniform"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"/>
									</Border>
							</Panel>
						</Grid>
					</Border>
					<!-- Selection highlight overlay -->
					<Border BorderBrush="#FF3D7FFF" BorderThickness="4"
							CornerRadius="{Binding $parent[Window].DataContext.ThumbnailSelectionCornerRadius}"
							IsVisible="{Binding IsSelected}"
							IsHitTestVisible="False"/>
				</Grid>
			</Border>
		</DataTemplate>
	</Window.Resources>
	<Window.Styles>
		<Style Selector="TreeViewItem">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}"/>
		</Style>
		<Style Selector="MenuItem">
			<Setter Property="Foreground" Value="{DynamicResource AppFgBrush}" />
		</Style>
		<Style Selector="MenuItem MenuItem">
			<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
		</Style>
		<Style Selector="MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
			<Setter Property="TextBlock.Foreground" Value="{Binding $parent[MenuItem].Foreground}" />
		</Style>
		<Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
			<Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
		</Style>
		<Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
			<Setter Property="Background" Value="{Binding $parent[Button].Background}" />
		</Style>
		<Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
		</Style>
	</Window.Styles>
    <Grid x:Name="RootGrid" Focusable="True" ColumnDefinitions="300,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">

        <!-- Left Sidebar -->
        <Border Grid.Column="0" Grid.RowSpan="6"
                BorderBrush="{DynamicResource CtrlBorderBrush}" BorderThickness="0,0,1,0"
                Padding="8" Background="{DynamicResource SidebarBgBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="图片文件夹"
                               FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource SecondaryFgBrush}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="添加文件夹" Width="90" Margin="0,0,5,0"
                                FontSize="12" Padding="6,4"
                                Click="BtnAddFolder_Click"/>
                        <Button Content="移除选中" Width="90"
                                FontSize="12" Padding="6,4"
                                Click="BtnRemoveFolder_Click"/>
                    </StackPanel>
                    <Panel Margin="0,0,0,8">
                        <TextBox x:Name="TxtFolderSearch" PlaceholderText="搜索文件夹..."
                                 Text="{Binding FolderSearchText}"
                                 GotFocus="TxtFolderSearch_GotFocus"
                                 Background="{DynamicResource InputBgBrush}"/>
                        <Popup IsOpen="{Binding IsFolderSearchPopupOpen}"
                               Placement="Bottom">
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource CtrlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="6"
                                    MaxWidth="280">
                                <ScrollViewer MaxHeight="300">
                                    <ItemsControl ItemsSource="{Binding FolderSearchSuggestions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FolderTreeNode">
                                                <Button Margin="1" Padding="6,3" FontSize="12"
                                                        Click="FolderSuggestion_Click"
                                                        HorizontalContentAlignment="Stretch"
                                                        HorizontalAlignment="Stretch">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Path}" FontSize="10"
                                                                   Foreground="{DynamicResource MutedFgBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Panel>
                </StackPanel>

                <TreeView x:Name="LstFolders"
                          ItemsSource="{Binding FolderTree}"
                          SelectedItem="{Binding SelectedFolderNode}"
                          SelectionChanged="LstFolders_SelectionChanged"
                          DragDrop.AllowDrop="True"
                          DragDrop.DragOver="LstFolders_DragOver"
                          DragDrop.Drop="LstFolders_Drop"
                          PointerPressed="LstFolders_PointerPressed"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.ContextMenu>
                        <ContextMenu Opened="FolderContextMenu_Opened">
                            <MenuItem x:Name="FolderAutoTagMenu" Header="自动打标…" Click="MenuComputeAutoTags_Click"/>
                            <MenuItem x:Name="FolderCharacterMenu" Header="匹配角色标签…" Click="MenuMatchCharacterEmbeddingsRecursive_Click"/>
                            <Separator/>
                            <MenuItem Header="计算图片指纹…" Click="MenuComputeHashes_Click"/>
                            <MenuItem x:Name="FolderVideoMenu" Header="生成视频原始帧…" Click="MenuComputeVideoOriginalFramesRecursive_Click"/>
                            <MenuItem x:Name="FolderStopVideoMenu" Header="停止视频原始帧生成" IsVisible="False" Click="MenuStopVideoOriginalFrames_Click"/>
                            <Separator/>
                            <MenuItem Header="设置显示名称…" Click="MenuRenameFolder_Click"/>
                            <MenuItem Header="归档文件夹" Click="MenuArchiveFolder_Click"/>
                            <MenuItem x:Name="FolderClearTagsMenu" Header="清空标签…" Click="MenuClearFolderTags_Click"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Margin="2" Background="{Binding HighlightColor,
                                Converter={StaticResource HexToBrush}}">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource MutedFgBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- Top Menu -->
        <DockPanel Grid.Row="0" Grid.Column="1" Background="{DynamicResource SidebarBgBrush}">
            <Menu DockPanel.Dock="Left" Background="Transparent">
                <MenuItem Header="设置" Height="28" Padding="12,4">
                    <MenuItem Header="设置主界面大小" Click="MenuSetMainSize_Click"/>
                    <MenuItem Header="设置预览窗口大小" Click="MenuSetPreviewSize_Click"/>
                    <Separator/>
                    <MenuItem Header="外观设置" Click="MenuAppearanceSettings_Click"/>
                    <MenuItem Header="壁纸设置" Click="MenuWallpaperSettings_Click"/>
                    <MenuItem Header="缩略图选项" Click="MenuThumbnailSettings_Click"/>
                    <MenuItem Header="缓存与 AI 设置" Click="MenuMemorySettings_Click"/>
                    <MenuItem Header="搜索设置" Click="MenuSearchSettings_Click"/>
                    <MenuItem Header="相似搜索向量索引" Click="MenuVectorIndexSettings_Click"/>
                    <MenuItem Header="归档文件夹" Click="MenuArchivedFolders_Click"/>
                    <Separator/>
                    <MenuItem Header="快捷键设置" Click="MenuShortcutSettings_Click"/>
                </MenuItem>
                <MenuItem Header="AI" Height="28" Padding="12,4">
                    <MenuItem Header="AI 推荐" Click="MenuAiRecommend_Click"/>
                    <Separator/>
                    <MenuItem Header="画师嵌入库构建" Click="MenuArtistDbBuilder_Click"/>
                    <MenuItem Header="角色嵌入库构建" Click="MenuCharacterDbBuilder_Click"/>
                </MenuItem>
                <MenuItem Header="工具" Height="28" Padding="12,4">
                    <MenuItem Header="标签管理" Click="MenuTagManage_Click"/>
                    <MenuItem Header="检测重复图片" Click="MenuDetectDuplicates_Click"/>
                </MenuItem>
                <MenuItem Header="帮助" Height="28" Padding="12,4" Click="MenuHelp_Click"/>
                <CheckBox Content="全展示" IsChecked="{Binding ShowAllSubfolders}"
                          VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"/>
            </Menu>
            <Menu HorizontalAlignment="Right" Background="Transparent">
                <MenuItem Header="排序 ▾" Height="28" Padding="12,4">
                    <MenuItem Header="按文件名 ↑" Click="SortFileNameAsc_Click"/>
                    <MenuItem Header="按文件名 ↓" Click="SortFileNameDesc_Click"/>

                    <MenuItem Header="按修改时间 ↑" Click="SortModifiedAsc_Click"/>
                    <MenuItem Header="按修改时间 ↓" Click="SortModifiedDesc_Click"/>

                    <MenuItem Header="按文件大小 ↑" Click="SortFileSizeAsc_Click"/>
                    <MenuItem Header="按文件大小 ↓" Click="SortFileSizeDesc_Click"/>

                    <MenuItem Header="按分辨率 ↑" Click="SortResolutionAsc_Click"/>
                    <MenuItem Header="按分辨率 ↓" Click="SortResolutionDesc_Click"/>
                </MenuItem>
            </Menu>
        </DockPanel>

        <!-- Toolbar Row 1: Actions -->
        <StackPanel Orientation="Horizontal" Margin="5,5,5,2" Grid.Row="1" Grid.Column="1">
            <Button Content="清除所有筛选" Margin="0,0,5,0"
                    FontSize="12" Padding="8,4"
                    Command="{Binding ClearFilterCommand}"/>
            <Button Content="返回搜索前" Margin="0,0,5,0"
                    FontSize="12" Padding="8,4"
                    IsEnabled="{Binding IsShowingSearchResult}"
                    Command="{Binding BackFromSearchCommand}"/>
            <TextBlock Text="{Binding StatusText}"
                       Margin="10,0,0,0" Foreground="{DynamicResource SecondaryFgBrush}" FontSize="12"
                       VerticalAlignment="Center"/>
            <Button Content="停止推理" Classes="toolbar-compact" Margin="10,0,0,0"
                    IsVisible="{Binding IsAutoTagRunning}"
                    Command="{Binding StopAutoTagCommand}"/>
            <TextBlock Text="{Binding BackgroundStatusText}"
                       Margin="16,0,0,0" Foreground="{DynamicResource AccentBrush}" FontSize="12"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Toolbar Row 2: selectable search layout -->
        <Grid Margin="5,0,5,2" Grid.Row="2" Grid.Column="1">
            <!-- A: frequently used search stays visible; advanced search opens in an overlay. -->
            <StackPanel IsVisible="{Binding IsSearchToolbarLayoutA}" Spacing="5">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="相似搜索和高级功能 ▾" Classes="toolbar-compact"
                            Margin="8,0,0,0" VerticalAlignment="Center"
                            ToolTip.Tip="展开相似搜索和高级功能设置"
                            DragDrop.AllowDrop="True"
                            DragDrop.DragOver="DragSearchZone_DragOver"
                            DragDrop.Drop="DragSearchZone_Drop">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight"
                                    FlyoutPresenterClasses="toolbar-flyout">
                                <WrapPanel Width="520" ItemSpacing="6" LineSpacing="6">
                                    <ComboBox Classes="toolbar-compact" Width="115"
                                              ItemsSource="{Binding SimilaritySearchModes}"
                                              SelectedIndex="{Binding SelectedSimilarityMode}"/>
                                    <Border x:Name="DragSearchZoneA" Classes="toolbar-drop-zone" Cursor="Hand"
                                            DragDrop.AllowDrop="True"
                                            DragDrop.DragOver="DragSearchZone_DragOver"
                                            DragDrop.Drop="DragSearchZone_Drop">
                                        <TextBlock Text="拖拽图片按所选模式搜索" VerticalAlignment="Center" FontSize="12"/>
                                    </Border>
                                    <TextBox Classes="toolbar-compact" Width="220"
                                             PlaceholderText="中文自然语言搜图"
                                             Text="{Binding NaturalLanguageQuery}"/>
                                    <Button Content="语义搜图" Classes="toolbar-compact"
                                            Command="{Binding SearchNaturalLanguageCommand}"/>
                                    <CheckBox Classes="toolbar-compact" Content="局部匹配（暂未实现）"
                                              Foreground="{DynamicResource AccentBrush}"
                                              VerticalAlignment="Center"/>
                                    <Button Content="停止搜索" Classes="toolbar-compact"
                                            Click="BtnStopSearch_Click"/>
                                </WrapPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="搜索范围" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryFgBrush}" FontSize="12"/>
                            <ComboBox Classes="toolbar-compact" Width="70" SelectedIndex="{Binding SearchScope}">
                                <ComboBoxItem>当前</ComboBoxItem>
                                <ComboBoxItem>递归</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <StackPanel>
                                <Border BorderBrush="{Binding SearchBoxBorderColor}" BorderThickness="1.5" CornerRadius="4">
                                    <TextBox x:Name="TxtTagSearchA" Classes="toolbar-compact" Text="{Binding TagSearchText}"
                                             Width="200" PlaceholderText="输入 Tag 名称…"
                                             Background="{DynamicResource InputBgBrush}" BorderThickness="0"
                                             KeyDown="TxtTagSearch_KeyDown" GotFocus="TxtTagSearch_GotFocus"/>
                                </Border>
                                <Popup IsOpen="{Binding IsTagSearchPopupOpenA}" Placement="Bottom">
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CtrlBorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="6" MaxWidth="300">
                                        <StackPanel>
                                            <TextBox Classes="toolbar-compact" PlaceholderText="过滤共有 Tag..." Text="{Binding CoTagFilterText}"
                                                     IsVisible="{Binding IsSuggestionCoTagMode}" Margin="0,0,0,4"/>
                                            <ScrollViewer MaxHeight="400">
                                                <ItemsControl ItemsSource="{Binding TagSearchSuggestions}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:TagCount">
                                                            <Button Classes="toolbar-compact" Margin="2" Padding="0" Click="TagSuggestion_Click" Tag="{Binding}">
                                                                <Border Padding="6,3" CornerRadius="3"><TextBlock Text="{Binding Name}"/></Border>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>
                            <Button Content="搜索" Classes="toolbar-compact" ToolTip.Tip="按 Tag 搜索"
                                    Command="{Binding SearchByTagCommand}"/>
                        </StackPanel>
                        <controls:DisplayFilterBar x:Name="DisplayFiltersBarA"/>
                        <TextBlock Text="{Binding LoadedInfoText}" Margin="10,0,0,0"
                                   Foreground="{DynamicResource SecondaryFgBrush}" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </WrapPanel>
                </DockPanel>
                <WrapPanel IsVisible="{Binding HasDisplayFilter}" ItemSpacing="6" LineSpacing="4">
                    <Button Content="{Binding TypeFilterText}" Classes="toolbar-chip" IsVisible="{Binding HasTypeFilter}"
                            Command="{Binding RemoveTypeFilterCommand}" ToolTip.Tip="移除此类型筛选"/>
                    <Button Content="{Binding OrientationFilterText}" Classes="toolbar-chip" IsVisible="{Binding HasOrientationFilter}"
                            Command="{Binding RemoveOrientationFilterCommand}" ToolTip.Tip="移除此方向筛选"/>
                    <Button Content="{Binding ContentRatingFilterText}" Classes="toolbar-chip" IsVisible="{Binding HasContentRatingFilter}"
                            Command="{Binding RemoveContentRatingFilterCommand}" ToolTip.Tip="移除年龄分级筛选"/>
                    <TextBlock Text="{Binding DisplayFilterCountText}" VerticalAlignment="Center" FontSize="12"/>
                    <TextBlock Text="没有符合当前筛选的文件" IsVisible="{Binding IsDisplayFilterEmpty}" VerticalAlignment="Center"/>
                    <Button Content="重置" Classes="toolbar-compact" Command="{Binding ResetDisplayFilterCommand}" IsVisible="{Binding IsDisplayFilterEmpty}"/>
                </WrapPanel>
            </StackPanel>

            <!-- C: a compact command bar with dedicated popups for low-frequency search controls. -->
            <StackPanel IsVisible="{Binding IsSearchToolbarLayoutC}" Spacing="5">
                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="范围" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryFgBrush}" FontSize="12"/>
                        <ComboBox Classes="toolbar-compact" Width="70" ToolTip.Tip="搜索范围" SelectedIndex="{Binding SearchScope}">
                            <ComboBoxItem>当前</ComboBoxItem>
                            <ComboBoxItem>递归</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <StackPanel>
                            <Border BorderBrush="{Binding SearchBoxBorderColor}" BorderThickness="1.5" CornerRadius="4">
                                <TextBox x:Name="TxtTagSearchC" Classes="toolbar-compact" Text="{Binding TagSearchText}"
                                         Width="200" PlaceholderText="输入 Tag 名称…"
                                         Background="{DynamicResource InputBgBrush}" BorderThickness="0"
                                         KeyDown="TxtTagSearch_KeyDown" GotFocus="TxtTagSearch_GotFocus"/>
                            </Border>
                            <Popup IsOpen="{Binding IsTagSearchPopupOpenC}" Placement="Bottom">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CtrlBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="6" MaxWidth="300">
                                    <StackPanel>
                                        <TextBox Classes="toolbar-compact" PlaceholderText="过滤共有 Tag..." Text="{Binding CoTagFilterText}"
                                                 IsVisible="{Binding IsSuggestionCoTagMode}" Margin="0,0,0,4"/>
                                        <ScrollViewer MaxHeight="400">
                                            <ItemsControl ItemsSource="{Binding TagSearchSuggestions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:TagCount">
                                                        <Button Classes="toolbar-compact" Margin="2" Padding="0" Click="TagSuggestion_Click" Tag="{Binding}">
                                                            <Border Padding="6,3" CornerRadius="3"><TextBlock Text="{Binding Name}"/></Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                        <Button Content="搜索" Classes="toolbar-compact" ToolTip.Tip="按 Tag 搜索" Command="{Binding SearchByTagCommand}"/>
                    </StackPanel>
                    <controls:DisplayFilterBar x:Name="DisplayFiltersBarC"/>
                    <Button Content="相似搜索 ▾" Classes="toolbar-compact"
                            ToolTip.Tip="点击展开相似搜索设置，也可直接拖入图片"
                            DragDrop.AllowDrop="True"
                            DragDrop.DragOver="DragSearchZone_DragOver"
                            DragDrop.Drop="DragSearchZone_Drop">
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Width="300" Margin="6" Spacing="8">
                                    <TextBlock Text="以图搜图" FontWeight="SemiBold"/>
                                    <ComboBox Classes="toolbar-compact" ItemsSource="{Binding SimilaritySearchModes}" SelectedIndex="{Binding SelectedSimilarityMode}"/>
                                    <Border x:Name="DragSearchZoneC" Classes="toolbar-drop-zone" Cursor="Hand" DragDrop.AllowDrop="True"
                                            DragDrop.DragOver="DragSearchZone_DragOver" DragDrop.Drop="DragSearchZone_Drop">
                                        <TextBlock Text="拖拽图片按所选模式搜索" TextAlignment="Center" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="更多…" Classes="toolbar-compact">
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Width="320" Margin="6" Spacing="8">
                                    <TextBlock Text="高级搜索" FontWeight="SemiBold"/>
                                    <TextBox Classes="toolbar-compact" PlaceholderText="中文自然语言搜图" Text="{Binding NaturalLanguageQuery}"/>
                                    <Button Content="语义搜图" Classes="toolbar-compact" HorizontalAlignment="Left" Command="{Binding SearchNaturalLanguageCommand}"/>
                                    <CheckBox Classes="toolbar-compact" Content="局部匹配（暂未实现）" Foreground="{DynamicResource AccentBrush}"/>
                                    <Separator/>
                                    <Button Content="停止搜索" Classes="toolbar-compact" HorizontalAlignment="Left" Click="BtnStopSearch_Click"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <TextBlock Text="{Binding LoadedInfoText}" Margin="8,0,0,0"
                               Foreground="{DynamicResource SecondaryFgBrush}" FontSize="12" VerticalAlignment="Center"/>
                </WrapPanel>
                <WrapPanel IsVisible="{Binding HasDisplayFilter}" ItemSpacing="6" LineSpacing="4">
                    <Button Content="{Binding TypeFilterText}" Classes="toolbar-chip" IsVisible="{Binding HasTypeFilter}"
                            Command="{Binding RemoveTypeFilterCommand}" ToolTip.Tip="移除此类型筛选"/>
                    <Button Content="{Binding OrientationFilterText}" Classes="toolbar-chip" IsVisible="{Binding HasOrientationFilter}"
                            Command="{Binding RemoveOrientationFilterCommand}" ToolTip.Tip="移除此方向筛选"/>
                    <Button Content="{Binding ContentRatingFilterText}" Classes="toolbar-chip" IsVisible="{Binding HasContentRatingFilter}"
                            Command="{Binding RemoveContentRatingFilterCommand}" ToolTip.Tip="移除年龄分级筛选"/>
                    <TextBlock Text="{Binding DisplayFilterCountText}" VerticalAlignment="Center" FontSize="12"/>
                    <TextBlock Text="没有符合当前筛选的文件" IsVisible="{Binding IsDisplayFilterEmpty}" VerticalAlignment="Center"/>
                    <Button Content="重置" Classes="toolbar-compact" Command="{Binding ResetDisplayFilterCommand}" IsVisible="{Binding IsDisplayFilterEmpty}"/>
                </WrapPanel>
            </StackPanel>
        </Grid>

        <!-- Toolbar Row 3: Paging + Zoom -->
        <Border Grid.Row="3" Grid.Column="1"
                Margin="5,1,5,2" Padding="6,2"
                BorderBrush="{DynamicResource CtrlBorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsVisible="{Binding IsPagedDisplay}">
                    <Button Content="上一页" Classes="toolbar-compact" Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Command="{Binding PrevPageCommand}"/>
                    <TextBlock Text="页:" VerticalAlignment="Center" Margin="0,0,5,0"
                               Foreground="{DynamicResource SecondaryFgBrush}" FontSize="12"/>
                    <ComboBox Classes="toolbar-compact" Width="80" ItemsSource="{Binding PageNumbers}"
                              VerticalAlignment="Center"
                              SelectedIndex="{Binding CurrentPage}"/>
                    <TextBlock Text="/" VerticalAlignment="Center" Margin="5,0,5,0"
                               Foreground="{DynamicResource SecondaryFgBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding TotalPages}" Foreground="{DynamicResource SecondaryFgBrush}" FontSize="12"
                               VerticalAlignment="Center"/>
                    <Button Content="下一页" Classes="toolbar-compact" Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding NextPageCommand}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="1"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,5,0">
                    <TextBlock Text="缩略图缩放:" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource SecondaryFgBrush}" FontSize="12"/>
                    <Slider Minimum="1" Maximum="10" Value="{Binding ZoomTick}"
                            Width="160" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search result navigation (visible only when showing search results) -->
        <Border Grid.Row="4" Grid.Column="1" Padding="5,2" Margin="5,0,5,0"
                IsVisible="{Binding HasSearchResults}"
                Background="{DynamicResource SidebarBgBrush}" CornerRadius="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="{Binding SearchResultInfo}" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,8,0"/>
                <Button Content="上一张" Margin="0,0,5,0" FontSize="12" Padding="6,3"
                        Command="{Binding PrevResultCommand}"/>
                <Button Content="下一张" Margin="0,0,5,0" FontSize="12" Padding="6,3"
                        Command="{Binding NextResultCommand}"/>
            </StackPanel>
        </Border>

        <!-- Image Grid Area -->
        <ScrollViewer x:Name="ThumbnailScrollViewer" Grid.Row="5" Grid.Column="1">
            <Grid x:Name="ImagePanelHost"
                  Background="Transparent"
                  PointerPressed="ImagePanelHost_PointerPressed"
                  PointerMoved="ImagePanelHost_PointerMoved"
                  PointerReleased="ImagePanelHost_PointerReleased">
                <ItemsControl x:Name="ItemsImages" ItemsSource="{Binding Images}"
                              ItemTemplate="{StaticResource ThumbnailItemTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:SmartWaterfallPanel
                            Mode="{Binding $parent[Window].DataContext.WaterfallMode}"
                            ColumnWidth="{Binding $parent[Window].DataContext.ThumbnailBaseWidth}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

                <ItemsControl x:Name="ContinuousItemsImages"
                              ItemsSource="{Binding ContinuousImageItemSource}"
                              ItemTemplate="{StaticResource ThumbnailItemTemplate}"
                              IsVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:VirtualizingWaterfallPanel
                                GeometryIndex="{Binding $parent[Window].DataContext.ContinuousDisplayGeometryIndex}"
                                ViewportBuffer="800"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Selection rectangle overlay -->
                <Rectangle x:Name="SelectionRectangle"
                           Stroke="#FF3D7FFF" StrokeThickness="1"
                           Fill="#403D7FFF"
                           IsVisible="False"
                           IsHitTestVisible="False"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>
            </Grid>
        </ScrollViewer>

    </Grid>
</Window>
