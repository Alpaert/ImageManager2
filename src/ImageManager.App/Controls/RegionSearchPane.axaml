<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ImageManager.App.Controls"
             x:Class="ImageManager.App.Controls.RegionSearchPane"
             AutomationProperties.Name="框选搜图输入">
    <UserControl.Styles>
        <Style Selector="TextBlock.region-muted">
            <Setter Property="Foreground" Value="{DynamicResource WorkspaceMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.region-tool">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="29"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="Border#StageBorder.region-drop, Border#StageBorder:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceAccentBrush}"/>
        </Style>
    </UserControl.Styles>
    <Border Background="{DynamicResource WorkspaceSurfaceBrush}"
            BorderBrush="{DynamicResource WorkspaceLineBrush}" BorderThickness="1"
            CornerRadius="8" Padding="11" ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowSpacing="8">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                <TextBlock Text="搜索图片" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource WorkspaceTextBrush}"/>
                <Button x:Name="ChangeButton" Grid.Column="1" Classes="workspace-quiet region-tool"
                        Content="换图" IsVisible="False" Click="Choose_Click"/>
                <Button Grid.Column="2" Classes="workspace-quiet region-tool" Content="粘贴图片"
                        ToolTip.Tip="从剪贴板粘贴图片文件或位图" Click="Paste_Click"/>
            </Grid>
            <Border Grid.Row="1" HorizontalAlignment="Left" Background="{DynamicResource WorkspaceCanvasBrush}"
                    BorderBrush="{DynamicResource WorkspaceLineBrush}" BorderThickness="1" CornerRadius="6" Padding="2">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="OriginalButton" Classes="workspace-quiet region-tool" Content="找原图"
                            Click="Original_Click"/>
                    <Button x:Name="SimilarButton" Classes="workspace-quiet region-tool workspace-preview-active"
                            Content="找相似内容" Click="Similar_Click"/>
                </StackPanel>
            </Border>
            <Border x:Name="StageBorder" Grid.Row="2" Background="{DynamicResource WorkspaceCanvasBrush}"
                    BorderBrush="{DynamicResource WorkspaceLineBrush}" BorderThickness="1" CornerRadius="5"
                    ClipToBounds="True" DragDrop.AllowDrop="True" DragDrop.DragOver="Stage_DragOver"
                    DragDrop.DragLeave="Stage_DragLeave" DragDrop.Drop="Stage_Drop">
                <Panel>
                    <controls:RegionSearchCanvas x:Name="Stage" Focusable="True" ClipToBounds="True"
                          AutomationProperties.Name="区域裁剪画布"
                          PointerPressed="Stage_PointerPressed" PointerMoved="Stage_PointerMoved"
                          PointerReleased="Stage_PointerReleased" PointerCaptureLost="Stage_PointerCaptureLost"
                          PointerWheelChanged="Stage_PointerWheelChanged"
                          KeyDown="Stage_KeyDown" KeyUp="Stage_KeyUp" LostFocus="Stage_LostFocus"/>
                    <StackPanel x:Name="EmptyInput" Spacing="9" Margin="12"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Width="30" Height="30" Stretch="Uniform" StrokeThickness="1.4"
                              Stroke="{DynamicResource WorkspaceMutedBrush}" Opacity="0.75"
                              Data="M2,3 H20 V17 H2 Z M2,14 L7,9 L12,14 L15,11 L20,16 M14,7 H15"
                              HorizontalAlignment="Center"/>
                        <Button Content="选择图片" Classes="workspace-quiet workspace-preview-active"
                                HorizontalAlignment="Center" Click="Choose_Click"/>
                        <TextBlock Text="也可拖入或粘贴图片" Classes="region-muted" TextAlignment="Center"/>
                    </StackPanel>
                </Panel>
            </Border>
            <WrapPanel Grid.Row="3" Orientation="Horizontal">
                <Button x:Name="CropButton" Classes="workspace-quiet region-tool workspace-preview-active"
                        Content="框选" Click="Crop_Click" IsEnabled="False"/>
                <Button x:Name="PanButton" Classes="workspace-quiet region-tool" Content="平移"
                        ToolTip.Tip="也可按住空格或鼠标中键平移" Click="Pan_Click" IsEnabled="False"/>
                <Button x:Name="FitButton" Classes="workspace-quiet region-tool" Content="适应"
                        ToolTip.Tip="重置缩放和位置" Click="Fit_Click" IsEnabled="False"/>
                <Button x:Name="ClearButton" Classes="workspace-quiet region-tool" Content="清除区域"
                        Click="Clear_Click" IsEnabled="False"/>
                <TextBlock x:Name="ZoomLabel" Text="100%" Classes="region-muted" Margin="5,0,0,0"
                           ToolTip.Tip="在画布上滚动鼠标滚轮缩放" IsVisible="False"/>
            </WrapPanel>
            <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="7">
                <TextBlock x:Name="SelectionLabel" Classes="region-muted" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="SearchButton" Grid.Column="1" Classes="workspace-primary" Content="搜索整图"
                        Click="Search_Click" IsEnabled="False"/>
            </Grid>
            <TextBlock x:Name="Feedback" Grid.Row="5" Classes="region-muted" TextWrapping="Wrap"/>
        </Grid>
    </Border>
</UserControl>
