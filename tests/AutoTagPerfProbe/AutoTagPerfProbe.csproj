<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <_OnnxRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_OnnxRid>
    <_OnnxRid Condition="'$(_OnnxRid)' == ''">win-x64</_OnnxRid>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Windows" Version="1.26.0"
                      GeneratePathProperty="true" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ImageManager.Common\ImageManager.Common.csproj" />
    <ProjectReference Include="..\..\src\ImageManager.Core\ImageManager.Core.csproj" />
    <ProjectReference Include="..\..\src\ImageManager.Infrastructure\ImageManager.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(PkgMicrosoft_ML_OnnxRuntime_Gpu_Windows)\runtimes\$(_OnnxRid)\native\onnxruntime.dll"
             CopyToOutputDirectory="PreserveNewest" Link="onnxruntime.dll" Visible="false" />
    <Content Include="$(PkgMicrosoft_ML_OnnxRuntime_Gpu_Windows)\runtimes\$(_OnnxRid)\native\onnxruntime_providers_cuda.dll"
             CopyToOutputDirectory="PreserveNewest" Link="onnxruntime_providers_cuda.dll" Visible="false" />
    <Content Include="$(PkgMicrosoft_ML_OnnxRuntime_Gpu_Windows)\runtimes\$(_OnnxRid)\native\onnxruntime_providers_shared.dll"
             CopyToOutputDirectory="PreserveNewest" Link="onnxruntime_providers_shared.dll" Visible="false" />
  </ItemGroup>
</Project>
